void special_spawn_condition(int param_1){
    const int CHATOT_OBJECT_ID = 0x122;

    spawn_object_if_missing(CHATOT_OBJECT_ID);
    set_object_position(CHATOT_OBJECT_ID,-24,1,162);
    set_object_rotation_instantly(CHATOT_OBJECT_ID,0,257,0);
    reset_object_after_event(CHATOT_OBJECT_ID);
}

void do_unlock_scenes(int param_1){
    int global_manager = get_module("GlobalManager");

    if(has_wand_check() == 1){
        fade_out(0,0,0,0x3c);
    }

    // Baltoy
    if(@syscall(0,0x15,0x29,global_manager,0x9d) == 1){
        show_unlock_cutscene_at_position(param_1,0x108,"42_00241",10,1,83.0,-2.0,-86.0);
    }

    // Claydol
    if(@syscall(0,0x15,0x29,global_manager,0x65) == 1){
        show_unlock_cutscene_at_position(param_1,0x10b,"42_00160",20,1,-730.0,-121.0,-563.8);
    }

    // Ninetales
    if(@syscall(0,0x15,0x29,global_manager,0x75) == 1){
        show_unlock_cutscene_at_position(param_1,0x112,"42_00242",20,1,-150.0,10.0,-907.0);
    }

    // Hitmonchan
    if(@syscall(0,0x15,0x29,global_manager,0x69) == 1){
        show_unlock_cutscene_at_position(param_1,0x114,"42_00200",20,1,-150.0,10.0,-907.0);
    }

    // Golem
    if(@syscall(0,0x15,0x29,global_manager,0x6c) == 1){
        show_unlock_cutscene_at_current_position(param_1,0x117,"42_00230",20,1);
    }

    // Infernape
    if(@syscall(0,0x15,0x29,global_manager,0x6b) == 1){
        show_unlock_cutscene_at_position(param_1,0x116,"42_00220",10,1,83.0,-2.0,-86.0);
    }

    // Torkoal
    if(@syscall(0,0x15,0x29,global_manager,0x63) == 1){
        // TODO: create proper unlock texts
        show_unlock_cutscene_at_current_position(param_1,0x109,"42_00170",20,1);
    }

    // Drifblim; for future usage
    if(@syscall(0,0x15,0x29,global_manager,0x1f) == 1){
        show_unlock_cutscene_at_current_position(param_1,0x11d,"42_00240",20,1);
    }

    // Ponyta
    if(@syscall(0,0x15,0x29,global_manager,0x1a) == 1){
        // TODO: create proper unlock texts
        show_unlock_cutscene_at_current_position(param_1,0x11e,"42_00180",20,1);
    }

    // Groudon
    if(@syscall(0,0x15,0x29,global_manager,0x9f) == 1){
        // TODO: create proper unlock texts
        show_unlock_cutscene_at_current_position(param_1,0x120,"42_00190",20,1);
    }

    // Magmortar
    if(@syscall(0,0x15,0x29,global_manager,0x9e) == 1){
        // TODO: create proper unlock texts
        show_unlock_cutscene_at_current_position(param_1,0x12f,"42_00210",20,1);
    }

    int event_script = get_module("EventScript");
    @syscall(0,0x15,400,event_script,0,1);
    int audio_state = @syscall(0,0x15,0x1f7,event_script,0x17e7);
    if(audio_state == 0){
        fade_in_bgm(0x1e);
    }
}

void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    do_unlock_scenes(param_1);
    special_spawn_condition(param_1);
    update_npc_story_state(param_1);
}

void A04_Z02_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    despawn_debug_prisma(0x4e23);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

void AR04ZN02_DEF(int param_1){
    despawn_debug_prisma(0x4e23);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

