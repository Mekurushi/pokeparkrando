void hitmontop_dialog(int param_1){
    const int object_id = 0x11a;
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    int npc_state = get_npc_state(object_id);
    if(npc_state == 0){
        @syscall(0,0x15,0x28,object_accessor,0x1373,0,1.0,1.0);
        int item_kind = get_held_item_kind();
        if(item_kind == 0xf){
            remove_held_item();
            if(!is_location_checked(object_id)){
                show_npc_dialog(param_1,"42_12092");
                friendship_banner("42_00480");
                check_location(object_id);
            }
            else{
                show_npc_dialog(param_1,"42_12091");
            }
            give_berries(400);
            end_event_script(param_1);
        }
        else if(item_kind == 0xd){
            remove_held_item();
            show_npc_dialog(param_1,"42_12093");
            give_berries(100);
            end_event_script(param_1);
        }
        else{
            show_npc_dialog(param_1,"42_12000");
        }
    }
    else if(npc_state == 1){
        @syscall(0,0x15,0x28,object_accessor,0x1374,0,1.0,1.0);
        show_npc_dialog(param_1,"42_12010");
    }
    else if(npc_state == 2){
        @syscall(0,0x15,0x28,object_accessor,0x1375,0,1.0,1.0);
        show_npc_dialog(param_1,"42_12020");
    }
    else if(npc_state == 3){
        show_npc_dialog(param_1,"42_12030");
    }
    else{
        show_npc_dialog(param_1,"42_12000");
    }
    if(npc_state != 2){
        int response = show_yes_no_question(param_1,"42_12040");
        if(response == 1){
            // when the power competition gets his own location add the usual power comp abstraction
            int result = start_power_competition(param_1,0,object_id);
            object_accessor = get_object_accessor(param_1,object_id,true);
            fade_in(0,0,0,0x3c);
            @syscall(0,0x15,0x28,object_accessor,0x1373,0,1.0,1.0);
            if(result == -1){
                show_npc_dialog(param_1,"42_12070");
            }
            else{
                give_berries(result);
                show_npc_dialog(param_1,"42_12080");
            }
            complete_event();
        }
        else{
            show_npc_dialog(param_1,"42_12050");
        }
    }
    end_event_script(param_1);
}

void magcargo_dialog(int param_1){
    const int object_id = 0x11b;
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    if(!is_location_checked(object_id)){
        int global_manager = get_module("GlobalManager");
        int has_bastiodon_prisma = @syscall(0,0x15,0x51,global_manager,9);
        int has_rhyperior_prisma = @syscall(0,0x15,0x51,global_manager,10);
        if(has_bastiodon_prisma == 0 && has_rhyperior_prisma == 0){
            show_npc_dialog(param_1,"42_60020");
        }
        else if(has_rhyperior_prisma == 0){
            show_npc_dialog(param_1,"42_60021");
        }
        else if(has_bastiodon_prisma == 0){
            show_npc_dialog(param_1,"42_60022");
        }
        else{
            show_npc_dialog(param_1,"42_60030");
            show_npc_dialog(param_1,"42_60040");
            friendship_banner("42_00490");
            check_location(object_id);
        }
    }
    else{
        show_npc_dialog(param_1,"42_12100");
    }
    end_event_script(param_1);
}

void rhyperior_dialog(int param_1){
    const int object_id = 0x11c;
    const int attraction_fee = 20;
    int global_manager = get_module("GlobalManager");
    int player_accessor = lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0x100d,0,1.0,1.0);

    if(!REMOVE_ERRAND_POWER_COMP_LOCATIONS){
        int errand_complete = @syscall(0,0x15,1,global_manager,"f0402TalkedDosidon");
        if(errand_complete == 0){
            int item_kind = get_held_item_kind();
            if(item_kind == 0xd){
                remove_held_item();
                @syscall(0,0x15,0,global_manager,"f0402TalkedDosidon",1);
                show_npc_dialog(param_1,"42_60100");
            }
            else{
                show_npc_dialog(param_1,"42_60101");
            }
        }
    }

    show_npc_dialog(param_1,"42_60110");
    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"42_60130");
    if(wants_to_enter == 1){
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < attraction_fee){
            @syscall(0,0x15,2,object_accessor,0x1b,10);
            @syscall(0,0x15,0x28,object_accessor,0x100d,0,1.0,1.0);
            show_npc_dialog(param_1,"42_60160");
        }
        else{
            @syscall(0,0x15,2,object_accessor,0x1c,10);
            @syscall(0,0x15,0x28,object_accessor,0x100d,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-attraction_fee);
            show_npc_dialog(param_1,"42_60150");
            @syscall(0,0x15,0x69,global_manager,MAGMA_ZONE_CIRCLE_AREA_RHYPERIOR_ATTRACTION_ID,1);
            @syscall(0,0x15,0,global_manager,"fRetAttraction",0xb);
            set_berry_counter_visible(false);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,MAGMA_ZONE_CIRCLE_AREA_RHYPERIOR_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0x100d,0,1.0,1.0);
        show_npc_dialog(param_1,"42_60140");
    }
    set_berry_counter_visible(false);
    end_event_script(param_1);
}

void drifblim_dialog(int param_1){
    const int object_id = 0x11d;
    int player_accessor = lock_player_and_get_accessor();
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    int field_info = get_module("mnFieldInfo");

    drop_held_item_animation();
    @syscall(0,0x15,0,global_manager,"rfFuwarideTaxi",0);
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);

    int service_count = @syscall(0,0x15,1,global_manager,"fFuwarideService");
    int service_dialog_state = @syscall(0,0x15,1,global_manager,"fTalkFuwarideService");
    if(service_count == 3 && service_dialog_state == 0){
        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        show_npc_dialog_mode_0(param_1,"02_80151");
        @syscall(0,0x15,0,global_manager,"fTalkFuwarideService",1);
        @syscall(0,0x15,2,player_accessor,0x4c,5);
        play_sound_effect(0x7fa,0);
        @syscall(0,0x15,0x11,field_info,0,"02_80153");
        wait_frames(180);
        @syscall(0,0x15,0x12,field_info);
        check_location(object_id);
    }

    service_dialog_state = @syscall(0,0x15,1,global_manager,"fTalkFuwarideService");
    if(service_count == 10 && service_dialog_state == 1){
        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        show_npc_dialog_mode_0(param_1,"02_80152");
        @syscall(0,0x15,0,global_manager,"fTalkFuwarideService",2);
    }

    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);

    int berry_cost = 0;
    if(service_count >= 0){
        if(service_count < 3){
            set_berry_counter_visible(true);
            show_npc_dialog_mode_0(param_1,"02_80110");
            berry_cost = 20;
        }
        else if(service_count < 10){
            set_berry_counter_visible(true);
            show_npc_dialog_mode_0(param_1,"02_80111");
            berry_cost = 10;
        }
        else{
            show_npc_dialog_mode_0(param_1,"02_80112");
        }
    }
    else{
        show_npc_dialog_mode_0(param_1,"02_80112");
    }

    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
    int berry_count = @syscall(0,0x15,0x15,global_manager);
    if(berry_count < berry_cost){
        show_npc_dialog_mode_0(param_1,"02_80120");
        set_berry_counter_visible(false);
    }
    else{
        choose_fast_travel_destination(param_1,object_id,0x2a);
        int destination = @syscall(0,0x15,1,global_manager,"rfFuwarideTaxi");

        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        if(destination == 99){
            show_npc_dialog_mode_0(param_1,"02_80140");
            set_berry_counter_visible(false);
        }
        else{
            @syscall(0,0x15,0x14,global_manager,-berry_cost);
            show_npc_dialog_mode_0(param_1,"02_80150");
            set_berry_counter_visible(false);
            @syscall(0,0x15,0,global_manager,"fFuwarideService",service_count + 1);
            drop_held_item_animation();
            fade_out_audio(30,false,false,false);
            @syscall(0,0x15,4,event_script,4,1);
        }
    }

    end_event_script(param_1);
}

void STAXIAREA(int param_1){
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int sound_manager = get_module("SoundManager");

    @syscall(0,0x15,100,event_script,0,0,0,0x3c);
    int destination = @syscall(0,0x15,1,global_manager,"rfFuwarideTaxi");
    @syscall(0,0x15,0x16,sound_manager,6,1.0);
    @syscall(0,0x15,0x16,sound_manager,8,1.0);
    @syscall(0,0x15,0x16,sound_manager,7,1.0);
    fade_out_sound(15);
    @syscall(0,0x15,400,event_script,3,0);

    if(destination == 0xb){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x15){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x1f){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x20){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x29){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x2a){
        travel_to(4,2,2);
    }
    else if(destination == 0x33){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x34){
        travel_to(5,2,0);
    }
    else if(destination == 0x3d){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x3e){
        travel_to(
            MAGMA_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_ZONE,
            MAGMA_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_AREA,
            MAGMA_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
}

