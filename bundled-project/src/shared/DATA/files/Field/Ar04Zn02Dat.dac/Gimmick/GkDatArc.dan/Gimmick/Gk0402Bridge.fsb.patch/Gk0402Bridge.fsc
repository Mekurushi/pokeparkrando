extern int get_module(string name);

export void WAIT(int param_1){
    int global_manager = get_module("GlobalManager");
    int has_rhyperior_prisma = @syscall(0,0x15,51,global_manager,0xa);
    if(has_rhyperior_prisma == 0){
        int bridge = @syscall(0,0x15,4,param_1);
        @syscall(0,0x15,0,bridge,param_1,0);
    }
    else{
        int bridge = @syscall(0,0x15,5,param_1);
        @syscall(0,0x15,0,bridge,param_1,2);
    }
}
