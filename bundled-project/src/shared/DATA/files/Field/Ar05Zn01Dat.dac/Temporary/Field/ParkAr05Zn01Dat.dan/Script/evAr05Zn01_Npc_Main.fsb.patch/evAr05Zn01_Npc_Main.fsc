void drifloon_dialog(int param_1){
    const int object_id = 0x142;
    int global_manager = get_module("GlobalManager");
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    @syscall(0,0x15,0x28,object_accessor,0xee1,0,1.0,1.0);
    int has_rotom_prisma = @syscall(0,0x15,0x51,global_manager,0xc);
    if(has_rotom_prisma == 1){
        if(!is_location_checked(object_id)){
            show_npc_dialog(param_1,"51_60110");
            friendship_banner("51_00452");
            check_location(object_id);
        }
        else{
            show_npc_dialog(param_1,"51_60111");
        }
    }
    else{
        show_npc_dialog(param_1,"51_60100");
    }
    end_event_script(param_1);
}

