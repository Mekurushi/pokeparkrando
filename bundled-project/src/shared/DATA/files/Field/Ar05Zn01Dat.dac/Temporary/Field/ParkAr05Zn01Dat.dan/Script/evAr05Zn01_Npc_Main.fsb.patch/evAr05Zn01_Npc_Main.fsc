void special_spawn_conditions(int param_1){
    const int CHATOT_OBJECT_ID = 0x150;

    spawn_object_if_missing(CHATOT_OBJECT_ID);
    set_object_position(CHATOT_OBJECT_ID,0x84,0xb7,-0x1bc);
    set_object_rotation_instantly(CHATOT_OBJECT_ID,0,0x10f,0);
    reset_object_after_event(CHATOT_OBJECT_ID);
}

void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    do_unlock_scenes(param_1);
    special_spawn_conditions(param_1);
    update_npc_story_state(param_1);
}

void A05_Z01_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    despawn_debug_prisma(0x4e21);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

void RETURN_AT04(int param_1){
    const int TANGROWTH_OBJECT_ID = 0x14e;

    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);

    setup_field(param_1);
    despawn_debug_prisma(0x4e21);
    despawn_player_object();
    wait_frames(1);
    spawn_player_object();
    lock_player_and_get_accessor();
    set_player_at(0x93,0xb9,-0x1dd);
    set_player_rotation(0,0x6d,0);
    @syscall(0,0x15,0xca,event_script,0);
    set_npc_state(TANGROWTH_OBJECT_ID,4);

    int has_tangrowth_prisma = @syscall(0,0x15,0x51,global_manager,3);
    if(has_tangrowth_prisma == 1){
        if(!is_location_checked(TANGROWTH_OBJECT_ID)){
            tangrowth_friendship_scene(param_1);
        }
        else{
            int tangrowth_accessor = lock_npc_and_get_accessor(TANGROWTH_OBJECT_ID);
            face_player_and_npc(TANGROWTH_OBJECT_ID,0);
            fade_in(0,0,0,0x1e);
            wait_frames(0x3c);
            @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
            @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
            do_dialog_with_scene(param_1,TANGROWTH_OBJECT_ID,"51_60073",0);
            reset_object_after_event(TANGROWTH_OBJECT_ID);
            reset_camera();
            @syscall(0,0x15,0xca,event_script,0x1e);
        }
    }
    else{
        int tangrowth_accessor = lock_npc_and_get_accessor(TANGROWTH_OBJECT_ID);
        face_player_and_npc(TANGROWTH_OBJECT_ID,0);
        fade_in(0,0,0,0x1e);
        wait_frames(0x3c);
        @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
        @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
        int attraction_clear_count = @syscall(0,0x15,0x61,global_manager,3);
        if(attraction_clear_count < 1){
            do_dialog_with_scene(param_1,TANGROWTH_OBJECT_ID,"51_60072",0);
        }
        else{
            do_dialog_with_scene(param_1,TANGROWTH_OBJECT_ID,"51_60071",0);
        }
        reset_object_after_event(TANGROWTH_OBJECT_ID);
        reset_camera();
        @syscall(0,0x15,0xca,event_script,0x1e);
    }

    complete_event();
    fade_in(0,0,0,0x1e);
    reset_object_after_event(TANGROWTH_OBJECT_ID);
    clear_wand_check();
    end_event_script(param_1);
}

