void tangrowth_dialog(int param_1){
    const int TANGROWTH_OBJECT_ID = 0x14e;
    const int ATTRACTION_FEE = 30;

    int global_manager = get_module("GlobalManager");
    int player_accessor = lock_player_and_get_accessor();
    int tangrowth_accessor = lock_npc_and_get_accessor(TANGROWTH_OBJECT_ID);
    face_player_and_npc(TANGROWTH_OBJECT_ID,0);
    @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
    @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
    show_npc_dialog(param_1,"51_60020");

    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"51_60040");
    if(wants_to_enter == 1){
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < ATTRACTION_FEE){
            @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
            @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
            show_npc_dialog(param_1,"51_60070");
        }
        else{
            @syscall(0,0x15,2,tangrowth_accessor,0x1c,10);
            @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
            show_npc_dialog(param_1,"51_60060");
            @syscall(0,0x15,0,global_manager,"fRetAttraction",4);
            set_berry_counter_visible(false);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,HAUNTED_ZONE_MAIN_AREA_TANGROWTH_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
        @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
        show_npc_dialog(param_1,"51_60050");
    }

    set_berry_counter_visible(false);
    end_event_script(param_1);
}

void tangrowth_friendship_scene(int param_1){
    const int TANGROWTH_OBJECT_ID = 0x14e;

    int event_script = get_module("EventScript");
    lock_player_and_get_accessor();
    set_npc_state(TANGROWTH_OBJECT_ID,4);
    despawn_player_object();
    despawn_field();
    spawn_player_object();
    lock_player_and_get_accessor();
    spawn_object_if_missing(TANGROWTH_OBJECT_ID);
    int tangrowth_accessor = lock_npc_and_get_accessor(TANGROWTH_OBJECT_ID);
    set_player_at(0x93,0xb9,-0x1da);
    set_player_rotation(0,0x83,0);
    @syscall(0,0x15,7,tangrowth_accessor,161.21,185.25,-485.37);
    @syscall(0,0x15,8,tangrowth_accessor,161.21,185.25,-485.37);
    @syscall(0,0x15,0x22,tangrowth_accessor,161.21,185.25,-485.37,1);
    face_object_towards_player_synchronously(TANGROWTH_OBJECT_ID,0);
    face_player_towards_object_synchronously(TANGROWTH_OBJECT_ID,0);

    vec3 camera_position = vec3{
        .x = 134.71,
        .y = 191.5,
        .z = -440.03
    };
    vec3 camera_target = vec3{
        .x = 149.87,
        .y = 196.58,
        .z = -466.85
    };
    @syscall(0,0x15,0xcb,event_script);
    @syscall(0,0x15,0xcc,event_script,-1,&camera_position);
    @syscall(0,0x15,0xcd,event_script,-1,&camera_target);

    fade_in(0,0,0,0x1e);
    wait_frames(0x1e);
    @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
    @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
    do_dialog_with_scene(param_1,TANGROWTH_OBJECT_ID,"51_60000",0);

    spawn_for_short_duration(0x4e21);
    wait_frames(0x6e);
    play_sound_effect(0x7ea,0);
    int field_info = get_module("mnFieldInfo");
    @syscall(0,0x15,0x11,field_info,1,"51_60001");
    wait_frames(0xb4);
    @syscall(0,0x15,0x12,field_info);
    wait_frames(0x1e);

    @syscall(0,0x15,2,tangrowth_accessor,0x1b,10);
    @syscall(0,0x15,0x28,tangrowth_accessor,0x1409,0,1.0,1.0);
    do_dialog_with_scene(param_1,TANGROWTH_OBJECT_ID,"51_60002",0);
    friendship_banner("51_00450");
    check_location(TANGROWTH_OBJECT_ID);

    fade_out(0,0,0,0x1e);
    reset_object_after_event(TANGROWTH_OBJECT_ID);
    @syscall(0,0x15,0xca,event_script,0);
    respawn_field();
    wait_frames(0x1e);
    fade_in(0,0,0,0x1e);
    reset_camera();
}

void drifblim_dialog(int param_1){
    const int object_id = 0x14f;
    int player_accessor = lock_player_and_get_accessor();
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    int field_info = get_module("mnFieldInfo");

    drop_held_item_animation();
    @syscall(0,0x15,0,global_manager,"rfFuwarideTaxi",0);
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);

    int service_count = @syscall(0,0x15,1,global_manager,"fFuwarideService");
    int service_dialog_state = @syscall(0,0x15,1,global_manager,"fTalkFuwarideService");
    if(service_count == 3 && service_dialog_state == 0){
        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        show_npc_dialog_mode_0(param_1,"02_80151");
        @syscall(0,0x15,0,global_manager,"fTalkFuwarideService",1);
        @syscall(0,0x15,2,player_accessor,0x4c,5);
        play_sound_effect(0x7fa,0);
        @syscall(0,0x15,0x11,field_info,0,"02_80153");
        wait_frames(180);
        @syscall(0,0x15,0x12,field_info);
        check_location(object_id);
    }

    service_dialog_state = @syscall(0,0x15,1,global_manager,"fTalkFuwarideService");
    if(service_count == 10 && service_dialog_state == 1){
        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        show_npc_dialog_mode_0(param_1,"02_80152");
        @syscall(0,0x15,0,global_manager,"fTalkFuwarideService",2);
    }

    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);

    int berry_cost = 0;
    if(service_count >= 0){
        if(service_count < 3){
            set_berry_counter_visible(true);
            show_npc_dialog_mode_0(param_1,"02_80110");
            berry_cost = 20;
        }
        else if(service_count < 10){
            set_berry_counter_visible(true);
            show_npc_dialog_mode_0(param_1,"02_80111");
            berry_cost = 10;
        }
        else{
            show_npc_dialog_mode_0(param_1,"02_80112");
        }
    }
    else{
        show_npc_dialog_mode_0(param_1,"02_80112");
    }

    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
    int berry_count = @syscall(0,0x15,0x15,global_manager);
    if(berry_count < berry_cost){
        show_npc_dialog_mode_0(param_1,"02_80120");
        set_berry_counter_visible(false);
    }
    else{
        choose_fast_travel_destination(param_1,object_id,0x33);
        int destination = @syscall(0,0x15,1,global_manager,"rfFuwarideTaxi");

        @syscall(0,0x15,2,object_accessor,0x1b,10);
        @syscall(0,0x15,0x28,object_accessor,0xef0,0,1.0,1.0);
        if(destination == 99){
            show_npc_dialog_mode_0(param_1,"02_80140");
            set_berry_counter_visible(false);
        }
        else{
            @syscall(0,0x15,0x14,global_manager,-berry_cost);
            show_npc_dialog_mode_0(param_1,"02_80150");
            set_berry_counter_visible(false);
            @syscall(0,0x15,0,global_manager,"fFuwarideService",service_count + 1);
            drop_held_item_animation();
            fade_out_audio(30,false,false,false);
            @syscall(0,0x15,4,event_script,0,1);
        }
    }

    end_event_script(param_1);
}

void chatot_dialog(int param_1){
    const int object_id = 0x150;
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    @syscall(0,0x15,2,object_accessor,0x1b,10);
    @syscall(0,0x15,0x28,object_accessor,0x96e,0,1.0,1.0);
    show_npc_dialog_mode_0(param_1,"02_70610");
    // TODO: hint system or similiar
    end_event_script(param_1);
}

void electrode_dialog(int param_1){
    const int ELECTRODE_OBJECT_ID = 0x151;

    lock_player_and_get_accessor();
    int electrode_accessor = lock_npc_and_get_accessor(ELECTRODE_OBJECT_ID);
    face_player_and_npc(ELECTRODE_OBJECT_ID,0);

    int npc_state = get_npc_state(ELECTRODE_OBJECT_ID);
    if(npc_state == 0){
        @syscall(0,0x15,0x28,electrode_accessor,0xed2,0,1.0,1.0);
        show_npc_dialog(param_1,"51_12100");
    }
    else if(npc_state == 1){
        @syscall(0,0x15,0x28,electrode_accessor,0xed3,0,1.0,1.0);
        show_npc_dialog(param_1,"51_12110");
    }
    else if(npc_state == 2){
        @syscall(0,0x15,0x28,electrode_accessor,0xed4,0,1.0,1.0);
        show_npc_dialog(param_1,"51_12120");
    }
    else if(npc_state == 3){
        show_npc_dialog(param_1,"51_10130");
    }
    else{
        show_npc_dialog(param_1,"51_10100");
    }

    end_event_script(param_1);
}

void power_competition_dialog(
    int param_1,
    int object_id,
    int sound_id,
    string friendship_banner_id,
    string question_dialog_id,
    string decline_dialog_id,
    string loss_dialog_id,
    string first_win_dialog_id,
    string repeat_win_dialog_id
){
    lock_player_and_get_accessor();
    lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    int response = show_yes_no_question(param_1,question_dialog_id);
    if(response == 1){
        int has_won = start_power_competition(param_1,0,object_id);
        special_spawn_conditions(param_1);
        int object_accessor = get_object_accessor(param_1,object_id,true);
        fade_in(0,0,0,0x3c);
        @syscall(0,0x15,0x28,object_accessor,sound_id,0,1.0,1.0);
        if(has_won == -1){
            show_npc_dialog(param_1,loss_dialog_id);
        }
        else{
            give_berries(has_won);
            if(is_location_checked(object_id) == false){
                show_npc_dialog(param_1,first_win_dialog_id);
                friendship_banner(friendship_banner_id);
                check_location(object_id);
            }
            else{
                show_npc_dialog(param_1,repeat_win_dialog_id);
            }
        }
        complete_event();
    }
    else{
        show_npc_dialog(param_1,decline_dialog_id);
    }
    end_event_script(param_1);
}

int start_power_competition(int param_1, int player_object_id, int enemy_object_id){
    store_pre_competition_state();
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int dispos_manager = get_module("DisposManager");
    int object_accessor = get_object_accessor(param_1,enemy_object_id,true);
    int player_event_accessor = get_player_accessor();
    vec3 object_position = vec3{.x = 0.0,.y = 0.0,.z = 0.0};
    vec3 player_position = vec3{.x = 0.0,.y = 0.0,.z = 0.0};
    drop_held_item_animation();
    @syscall(0,0x15,0x13,object_accessor,&object_position);
    @syscall(0,0x15,0x13,player_event_accessor,&player_position);
    @syscall(0,0x15,0xca,event_script,0x1e);
    wait_frames(0x1e);
    int dispos_id = @syscall(0,0x15,0xc,dispos_manager,enemy_object_id);
    int result = run_power_competition(player_object_id,enemy_object_id);
    if(result == -1){
        reset_win_counter();
    }
    else{
        @syscall(0,0x15,0x93,global_manager,dispos_id);
        increment_win_counter();
    }
    despawn_player_object();
    spawn_player_object();
    int player_accessor = lock_player_and_get_accessor();
    @syscall(0,0x15,7,player_accessor,player_position.x,player_position.y,player_position.z);
    @syscall(0,0x15,8,player_accessor,player_position.x,player_position.y,player_position.z);
    @syscall(0,0x15,0x22,player_accessor,player_position.x,player_position.y,player_position.z,1);
    int player_state = @syscall(0,0x15,0x30,player_accessor);
    if(player_state == 0){
        @syscall(0,0x15,2,player_accessor,0,0);
    }
    @syscall(0,0x15,0,player_accessor,0);
    @syscall(0,0x15,0x8e,global_manager,dispos_id);
    respawn_field();
    lock_npc_and_get_accessor(enemy_object_id);
    object_accessor = get_object_accessor(param_1,enemy_object_id,true);
    @syscall(0,0x15,7,object_accessor,object_position.x,object_position.y,object_position.z);
    @syscall(0,0x15,8,object_accessor,object_position.x,object_position.y,object_position.z);
    @syscall(0,0x15,0x22,object_accessor,object_position.x,object_position.y,object_position.z,1);
    int object_state = @syscall(0,0x15,0x10,dispos_manager,enemy_object_id);
    if(object_state == 0){
        @syscall(0,0x15,0x2a,object_accessor,5);
    }
    else{
        @syscall(0,0x15,0x2a,object_accessor,10);
        @syscall(0,0x15,0x2b,object_accessor,4);
    }
    face_object_accessors_instantly(player_accessor,object_accessor,1);
    @syscall(0,0x15,0xca,event_script,-1);
    @syscall(0,0x15,0xd7,event_script,enemy_object_id);
    restore_pre_competition_state(enemy_object_id);
    return result;
}

void reset_win_counter(){
    int global_manager = get_module("GlobalManager");
    @syscall(0,0x15,0,global_manager,"zfPowerComp",0);
    @syscall(0,0x15,0,global_manager,"f0501BattleCounterNum",0);
}

void increment_win_counter(){
    int global_manager = get_module("GlobalManager");
    int counter_num = @syscall(0,0x15,1,global_manager,"f0501BattleCounterNum");
    int increased_counter = counter_num + 1;
    @syscall(0,0x15,0,global_manager,"f0501BattleCounterNum",increased_counter);
    if(increased_counter >= BATTLE_COUNT){
        @syscall(0,0x15,0,global_manager,"f0501BattleCounter",1);
    }
}

bool is_bestfriend(int object_id){
    int global_manager = get_module("GlobalManager");
    int dispos_manager = get_module("DisposManager");
    int friendship_id = @syscall(0,0x15,0xe,dispos_manager,object_id);
    return @syscall(0,0x15,0x4b,global_manager,friendship_id) == 1;
}

bool is_location_checked(int object_id){
    return is_bestfriend(object_id);
}

void check_location(int object_id){
    set_bestfriend(object_id);
}

const int QUIZ_DIALOG_INTRO = 0;
const int QUIZ_DIALOG_ROUND_INTRO = 1;
const int QUIZ_DIALOG_CORRECT = 2;
const int QUIZ_DIALOG_WRONG = 3;

void quiz_dialog(
    int param_1,
    int object_id,
    int sound_id,
    int quiz_id,
    string friendship_banner_id,
    string question_dialog_id,
    string decline_dialog_id,
    string loss_dialog_id,
    string first_win_dialog_id,
    string repeat_win_dialog_id
){
    int player_accessor = lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    int response = show_yes_no_question(param_1,question_dialog_id);
    if(response == 1){
        int has_won = start_quiz(param_1,object_id,quiz_id,player_accessor);
        @syscall(0,0x15,0x28,object_accessor,sound_id,0,1.0,1.0);
        if(has_won == -1){
            reset_win_counter();
            play_sound_effect(0x803,0);
            show_npc_dialog(param_1,loss_dialog_id);
            fade_in_bgm(0x1e);
        }
        else{
            increment_win_counter();
            give_berries(20);
            play_sound_effect(0x802,0);
            @syscall(0,0x15,2,player_accessor,0x4e,5);
            if(is_location_checked(object_id) == false){
                show_npc_dialog(param_1,first_win_dialog_id);
                fade_in_bgm(0x1e);
                check_location(object_id);
                @syscall(0,0x15,1,player_accessor,0x4c);
                friendship_banner(friendship_banner_id);
            }
            else{
                show_npc_dialog(param_1,repeat_win_dialog_id);
                fade_in_bgm(0x1e);
            }
            @syscall(0,0x15,2,player_accessor,0,5);
            int global_manager = get_module("GlobalManager");
            @syscall(0,0x15,0x93,global_manager,5);
        }
        int sound_manager = get_module("SoundManager");
        @syscall(0,0x15,0x16,sound_manager,0xc,1.0);
        wait_frames(10);
        complete_event();
    }
    else{
        show_npc_dialog(param_1,decline_dialog_id);
    }
    end_event_script(param_1);
}

int start_quiz(int param_1, int object_id, int quiz_id, int player_accessor){
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int sound_manager = get_module("SoundManager");
    @syscall(0,0x15,0x8e,global_manager,5);
    drop_held_item_animation();
    @syscall(0,0x15,0x192,event_script,10);
    wait_frames(10);
    @syscall(0,0x15,0x16,sound_manager,0xc,0);
    play_sound_effect(0x1832,0x1e);
    show_npc_dialog(param_1,get_quiz_dialog_id(quiz_id,QUIZ_DIALOG_INTRO,0));
    show_npc_dialog(param_1,get_quiz_dialog_id(quiz_id,QUIZ_DIALOG_INTRO,1));
    int object_accessor = get_object_accessor(param_1,object_id,true);
    for(int round = 0; round < 3; round = round + 1){
        int question = @syscall(0,0x24,4);
        if(ask_and_handle_quiz_question(
               param_1,object_accessor,player_accessor,get_quiz_question_id(quiz_id,round,question,0),
               get_quiz_question_id(quiz_id,round,question,1),get_quiz_question_id(quiz_id,round,question,2),
               get_quiz_question_id(quiz_id,round,question,3),get_quiz_question_id(quiz_id,round,question,4),
               get_quiz_dialog_id(quiz_id,QUIZ_DIALOG_CORRECT,0),
               get_quiz_dialog_id(quiz_id,QUIZ_DIALOG_WRONG,0)) != 1){
            @syscall(0,0x15,0x1f5,event_script,0x1832,10);
            wait_frames(10);
            return -1;
        }
        if(round < 2){
            show_npc_dialog(param_1,get_quiz_dialog_id(quiz_id,QUIZ_DIALOG_ROUND_INTRO,round));
        }
    }
    @syscall(0,0x15,0x1f5,event_script,0x1832,10);
    wait_frames(10);
    return 1;
}

int ask_and_handle_quiz_question(
    int param_1,
    int object_accessor,
    int player_accessor,
    string question_id,
    string answer_1_id,
    string answer_2_id,
    string answer_3_id,
    string correct_answer_id,
    string correct_dialog_id,
    string wrong_dialog_id
){
    int result = ask_quiz_question(param_1,question_id,answer_1_id,answer_2_id,answer_3_id,correct_answer_id);
    if(result == 1){
        play_sound_effect(0x499,0);
        @syscall(0,0x15,2,object_accessor,0x20,10);
        show_npc_dialog(param_1,correct_dialog_id);
        return 1;
    }
    play_sound_effect(0x62,0);
    @syscall(0,0x15,2,object_accessor,0x21,10);
    @syscall(0,0x15,2,player_accessor,0x51,5);
    show_npc_dialog(param_1,wrong_dialog_id);
    show_npc_dialog(param_1,correct_answer_id);
    return -1;
}

