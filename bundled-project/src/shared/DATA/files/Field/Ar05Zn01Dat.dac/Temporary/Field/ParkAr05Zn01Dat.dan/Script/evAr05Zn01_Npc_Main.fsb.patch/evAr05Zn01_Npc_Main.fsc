string get_quiz_dialog_id(int quiz_id, int kind, int index){
    if(kind == QUIZ_DIALOG_INTRO){
        if(index == 0){
            return "51_10160";
        }
        return "51_10191";
    }
    if(kind == QUIZ_DIALOG_ROUND_INTRO){
        if(index == 0){
            return "51_10192";
        }
        return "51_10193";
    }
    if(kind == QUIZ_DIALOG_CORRECT){
        return "51_10195";
    }
    return "51_10196";
}

void STAXIAREA(int param_1){
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int sound_manager = get_module("SoundManager");

    @syscall(0,0x15,100,event_script,0,0,0,0x3c);
    int destination = @syscall(0,0x15,1,global_manager,"rfFuwarideTaxi");
    @syscall(0,0x15,0x16,sound_manager,6,1.0);
    @syscall(0,0x15,0x16,sound_manager,8,1.0);
    @syscall(0,0x15,0x16,sound_manager,7,1.0);
    fade_out_sound(15);
    @syscall(0,0x15,400,event_script,3,0);

    if(destination == 0xb){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x15){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x1f){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x20){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x29){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x2a){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x33){
        travel_to(5,1,2);
    }
    else if(destination == 0x34){
        travel_to(5,2,0);
    }
    else if(destination == 0x3d){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x3e){
        travel_to(
            HAUNTED_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_ZONE,
            HAUNTED_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_AREA,
            HAUNTED_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
}
