extern int get_module(string name);
extern int lock_player_and_get_accessor();
extern int lock_npc_and_get_accessor(int object_id);
extern void face_player_and_npc(int object_id, int param_2);
extern void show_npc_dialog(int param_1, string dialog_id);
extern void friendship_banner(string banner_id);
extern void set_bestfriend(int object_id);
extern void set_berry_counter_visible(bool visible);
extern int attraction_show_yes_no_question(int param_1, string dialog_id);
extern void fade_out(int red, int green, int blue, int frames);
extern void enter_attraction(int param_1, int attraction_id);
extern void rotate_object(int object_id, int x, int y, int z);
extern void end_event_script(int param_1);
extern void despawn_debug_prisma(int object_id);
extern void setup_player_for_zone();
extern void update_npc_story_state(int param_1);
extern void fade_in(int red, int green, int blue, int frames);
extern void clear_wand_check();
extern void despawn_player_object();
extern void wait_frames(int frames);
extern void spawn_player_object();
extern void set_player_at(int x, int y, int z);
extern void set_player_rotation(int x, int y, int z);
extern void do_dialog_with_scene(int param_1, int object_id, string dialog_id, int scene_id);
extern void reset_object_after_event(int object_id);
extern void reset_camera();
extern void restore_player_control();

config int MAGMA_ZONE_BLAZIKEN_AREA_BLAZIKEN_ATTRACTION_ID;

void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    update_npc_story_state(param_1);
}

void A04_Z03_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    despawn_debug_prisma(0x4e20);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

void RETURN_AT12(int param_1){
    const int BLAZIKEN_OBJECT_ID = 0x138;

    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);

    setup_field(param_1);
    despawn_debug_prisma(0x4e20);
    despawn_player_object();
    wait_frames(1);
    spawn_player_object();
    lock_player_and_get_accessor();
    set_player_at(0,0,-344);
    set_player_rotation(0,-177,0);
    @syscall(0,0x15,0xca,event_script,-1);

    int return_attraction = @syscall(0,0x15,1,global_manager,"fRetAttraction");
    if(return_attraction == 12){
        int blaziken_accessor = lock_npc_and_get_accessor(BLAZIKEN_OBJECT_ID);
        fade_in(0,0,0,0x1e);
        face_player_and_npc(BLAZIKEN_OBJECT_ID,0);
        @syscall(0,0x15,2,blaziken_accessor,0x1b,10);
        @syscall(0,0x15,0x28,blaziken_accessor,0xf68,0,1.0,1.0);

        int has_blaziken_prisma = @syscall(0,0x15,0x51,global_manager,0xb);
        if(has_blaziken_prisma == 1){
            do_dialog_with_scene(param_1,BLAZIKEN_OBJECT_ID,"43_60074",0);
        }
        else{
            do_dialog_with_scene(param_1,BLAZIKEN_OBJECT_ID,"43_60072",0);
        }

        reset_object_after_event(BLAZIKEN_OBJECT_ID);
        reset_camera();
        @syscall(0,0x15,0xca,event_script,0x1e);
    }

    fade_in(0,0,0,0x1e);
    clear_wand_check();
    restore_player_control();
    reset_camera();
    end_event_script(param_1);
}

void blaziken_dialog(int param_1){
    const int BLAZIKEN_OBJECT_ID = 0x138;
    const int ATTRACTION_FEE = 20;

    int global_manager = get_module("GlobalManager");
    int player_accessor = lock_player_and_get_accessor();
    int blaziken_accessor = lock_npc_and_get_accessor(BLAZIKEN_OBJECT_ID);
    face_player_and_npc(BLAZIKEN_OBJECT_ID,0);
    @syscall(0,0x15,2,blaziken_accessor,0x1b,10);
    @syscall(0,0x15,0x28,blaziken_accessor,0xf68,0,1.0,1.0);

    int has_rayquaza_prisma = @syscall(0,0x15,0x51,global_manager,0xb);
    if(has_rayquaza_prisma == 1 && !is_location_checked(BLAZIKEN_OBJECT_ID)){
        show_npc_dialog(param_1,"43_60071");
        @syscall(0,0x15,1,player_accessor,0x4c);
        friendship_banner("43_00020");
        check_location(BLAZIKEN_OBJECT_ID);
    }

    if(!is_location_checked(BLAZIKEN_OBJECT_ID)){
        show_npc_dialog(param_1,"43_60030");
    }
    else{
        show_npc_dialog(param_1,"43_60021");
    }

    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"43_60040");
    if(wants_to_enter == 1){
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < ATTRACTION_FEE){
            @syscall(0,0x15,2,blaziken_accessor,0x1b,10);
            @syscall(0,0x15,0x28,blaziken_accessor,0xf68,0,1.0,1.0);
            show_npc_dialog(param_1,"43_60070");
        }
        else{
            @syscall(0,0x15,2,blaziken_accessor,0x1c,10);
            @syscall(0,0x15,0x28,blaziken_accessor,0xf68,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
            show_npc_dialog(param_1,"43_60060");
            @syscall(0,0x15,0,global_manager,"fRetAttraction",0xc);
            set_berry_counter_visible(false);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,MAGMA_ZONE_BLAZIKEN_AREA_BLAZIKEN_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,blaziken_accessor,0x1b,10);
        @syscall(0,0x15,0x28,blaziken_accessor,0xf68,0,1.0,1.0);
        show_npc_dialog(param_1,"43_60050");
    }

    set_berry_counter_visible(false);
    rotate_object(BLAZIKEN_OBJECT_ID,0,0,0);
    end_event_script(param_1);
}

void charmander_dialog(int param_1){
    const int CHARMANDER_OBJECT_ID = 0x258;
    lock_player_and_get_accessor();
    get_module("EventScript");
    int charmander_accessor = lock_npc_and_get_accessor(CHARMANDER_OBJECT_ID);
    face_player_and_npc(CHARMANDER_OBJECT_ID,0);
    @syscall(0,0x15,0x28,charmander_accessor,0x13cd,0,1.0,1.0);
    show_npc_dialog(param_1,"43_60080");
    end_event_script(param_1);
}

bool is_location_checked(int object_id){
    return is_bestfriend(object_id);
}

bool is_bestfriend(int object_id){
    int global_manager = get_module("GlobalManager");
    int dispos_manager = get_module("DisposManager");
    int friendship_id = @syscall(0,0x15,0xe,dispos_manager,object_id);
    return @syscall(0,0x15,0x4b,global_manager,friendship_id) == 1;
}

void check_location(int object_id){
    set_bestfriend(object_id);
}
