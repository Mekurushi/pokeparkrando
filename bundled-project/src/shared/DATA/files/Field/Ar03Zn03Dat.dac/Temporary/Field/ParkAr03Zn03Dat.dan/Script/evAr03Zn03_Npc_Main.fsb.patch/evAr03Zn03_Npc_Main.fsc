config int ICE_ZONE_EMPOLEON_AREA_EMPOLEON_ATTRACTION_ID;

void A03_Z03_INIT(int param_1){
  int event_script = get_module("EventScript");
  @syscall(0,0x15,0x65,event_script,0,0,0,1);
  despawn_debug_prisma(20000);
  lock_player_and_get_accessor();
  setup_player_for_zone();
  special_spawn_conditions(param_1);
  update_npc_state(param_1);
  fade_in(0,0,0,0x1e);
  end_event_script(param_1);
  return;
}

void special_spawn_conditions(int param_1){
  const int PIPLUP_OBJECT_ID = 0x244;
  const int EMPOLEON_OBJECT_ID = 0xd1;

  // always spawning piplup because why not
  spawn_object_if_missing(PIPLUP_OBJECT_ID);
  set_object_position(PIPLUP_OBJECT_ID,4,0x23,-346);
  face_object_towards_object_synchronously(PIPLUP_OBJECT_ID,EMPOLEON_OBJECT_ID,0);
  reset_object_after_event(PIPLUP_OBJECT_ID);
}

void empoleon_dialog(int param_1){
  const int EMPOLEON_OBJECT_ID = 0xd1;
  const int ATTRACTION_FEE = 10;

  int player_accessor = lock_player_and_get_accessor();
  int empoleon_accessor = lock_npc_and_get_accessor(EMPOLEON_OBJECT_ID);

  face_player_and_npc(EMPOLEON_OBJECT_ID,0);
  @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
  @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
  set_berry_counter_visible(true);

  int wants_to_enter = attraction_show_yes_no_question(param_1,"33_60060");
  if(wants_to_enter == 1){
    int global_manager = get_module("GlobalManager");
    int berry_count = @syscall(0,0x15,0x15,global_manager);
    if(berry_count < ATTRACTION_FEE){
      @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
      @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
      show_npc_dialog(param_1,"33_60090");
    }
    else{
      @syscall(0,0x15,2,empoleon_accessor,0x1c,10);
      @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
      @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
      show_npc_dialog(param_1,"33_60080");
      @syscall(0,0x15,0,global_manager,"fRetAttraction",9);
      set_berry_counter_visible(false);
      fade_out(0,0,0,0x1e);
      @syscall(0,0x15,0,player_accessor,0);
      enter_attraction(param_1,ICE_ZONE_EMPOLEON_AREA_EMPOLEON_ATTRACTION_ID);
    }
  }
  else{
    @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
    @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
    show_npc_dialog(param_1,"33_60070");
  }

  set_berry_counter_visible(false);
  rotate_object(EMPOLEON_OBJECT_ID,0,0,0);
  end_event_script(param_1);
  return;
}

void piplup_dialog(int param_1){
  lock_player_and_get_accessor();
  get_module("EventScript");
  int piplup_accessor = lock_npc_and_get_accessor(0x244);
  face_player_and_npc(0x244,0);
  @syscall(0,0x15,2,piplup_accessor,0x1b,10);
  @syscall(0,0x15,0x28,piplup_accessor,0x98c,0,1.0,1.0);
  show_npc_dialog(param_1,"33_10000");
  end_event_script(param_1);
  return;
}

void RETURN_AT09(int param_1){
  const int EMPOLEON_OBJECT_ID = 0xd1;

  int global_manager = get_module("GlobalManager");
  int event_script = get_module("EventScript");
  @syscall(0,0x15,0x65,event_script,0,0,0,1);

  lock_player_and_get_accessor();
  despawn_player_object();
  special_spawn_conditions(param_1);
  despawn_debug_prisma(20000);
  wait_frames(1);
  spawn_player_object();
  set_player_at(0,0x23,-346);
  face_player_towards_object_synchronously(EMPOLEON_OBJECT_ID,0);
  lock_player_and_get_accessor();
  @syscall(0,0x15,0xca,event_script,-1);

  int chapter = get_chapter();
  int has_empoleon_prisma = @syscall(0,0x15,0x51,global_manager,8);
  if(has_empoleon_prisma == 1){
    if(!is_location_checked(EMPOLEON_OBJECT_ID)){
      empoleon_friendship_scene(param_1);
    }
    else{
      int empoleon_accessor = lock_npc_and_get_accessor(EMPOLEON_OBJECT_ID);
      fade_in(0,0,0,0x1e);
      face_player_and_npc(EMPOLEON_OBJECT_ID,0);
      @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
      @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
      do_dialog_with_scene(param_1,EMPOLEON_OBJECT_ID,"33_60130",0);
      wait_frames(2);
      reset_camera();
      @syscall(0,0x15,0xca,event_script,0x14);
      reset_object_after_event(EMPOLEON_OBJECT_ID);
    }
  }
  else{
    int empoleon_accessor = lock_npc_and_get_accessor(EMPOLEON_OBJECT_ID);
    fade_in(0,0,0,0x1e);
    face_player_and_npc(EMPOLEON_OBJECT_ID,0);
    @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
    @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
    do_dialog_with_scene(param_1,EMPOLEON_OBJECT_ID,"33_60110",0);

    wait_frames(2);
    reset_camera();
    @syscall(0,0x15,0xca,event_script,0x14);
    reset_object_after_event(EMPOLEON_OBJECT_ID);
  }

  update_npc_state(param_1);
  fade_in(0,0,0,0x1e);
  restore_player_control();
  end_event_script(param_1);
  return;
}

void empoleon_friendship_scene(int param_1){
  const int EMPOLEON_OBJECT_ID = 0xd1;
  const int PIPLUP_OBJECT_ID = 0x244;

  int event_script = get_module("EventScript");
  int player_accessor = lock_player_and_get_accessor();
  int empoleon_accessor = lock_npc_and_get_accessor(EMPOLEON_OBJECT_ID);

  despawn(PIPLUP_OBJECT_ID);
  face_object_accessors_instantly(player_accessor,empoleon_accessor,1);
  EA03_Z03_D00(param_1);
  fade_out(0,0,0,0x1e);

  spawn_object_if_missing(PIPLUP_OBJECT_ID);
  int piplup_accessor = lock_npc_and_get_accessor(PIPLUP_OBJECT_ID);
  set_player_at(4,0x23,-344);
  set_object_position(PIPLUP_OBJECT_ID,-4,0x23,-344);
  set_object_rotation_instantly(EMPOLEON_OBJECT_ID,0,0,0);
  face_player_towards_object_synchronously(EMPOLEON_OBJECT_ID,0);
  face_object_towards_object_synchronously(PIPLUP_OBJECT_ID,EMPOLEON_OBJECT_ID,0);

  vec3 camera_position = vec3{
    .x = 8.94,
    .y = 38.34,
    .z = -315.61
  };
  vec3 camera_target = vec3{
    .x = 1.22,
    .y = 44.67,
    .z = -344.52
  };
  @syscall(0,0x15,0xcb,event_script);
  @syscall(0,0x15,0xcc,event_script,-1,&camera_position);
  @syscall(0,0x15,0xcd,event_script,-1,&camera_target);

  player_accessor = lock_player_and_get_accessor();
  @syscall(0,0x15,0,player_accessor,0);
  empoleon_accessor = get_object_accessor(param_1,EMPOLEON_OBJECT_ID,true);
  @syscall(0,0x15,0,empoleon_accessor,0);
  lock_npc_and_get_accessor(EMPOLEON_OBJECT_ID);
  wait_frames(0x1e);
  fade_in(0,0,0,0x1e);

  @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
  @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
  do_dialog_with_scene(param_1,EMPOLEON_OBJECT_ID,"33_60000",0);

  spawn_for_short_duration(20000);
  wait_frames(0x6e);
  play_sound_effect(0x7ea,0);
  int field_info = get_module("mnFieldInfo");
  @syscall(0,0x15,0x11,field_info,1,"33_60010");
  wait_frames(0xb4);
  @syscall(0,0x15,0x12,field_info);
  wait_frames(0x1e);

  @syscall(0,0x15,2,empoleon_accessor,0x1b,10);
  @syscall(0,0x15,0x28,empoleon_accessor,0xca7,0,1.0,1.0);
  do_dialog_with_scene(param_1,EMPOLEON_OBJECT_ID,"33_60020",0);

  check_location(EMPOLEON_OBJECT_ID);

  wait_frames(0x14);
  face_player_and_npc_synchronously(PIPLUP_OBJECT_ID,1);
  @syscall(0,0x15,2,piplup_accessor,0x1b,10);
  @syscall(0,0x15,0x28,piplup_accessor,0x98c,0,1.0,1.0);
  do_dialog_with_scene(param_1,PIPLUP_OBJECT_ID,"33_60021",0);
  wait_frames(10);

  @syscall(0,0x15,5,event_script);
  wait_frames(1);
  fade_out(0,0,0,0x1e);
  set_player_rotation(0,0xb4,0);
  @syscall(0,0x15,0xca,event_script,-1);
  reset_object_after_event(EMPOLEON_OBJECT_ID);
  despawn(PIPLUP_OBJECT_ID);
  wait_frames(0x1e);
  fade_in(0,0,0,0x1e);
  return;
}

bool is_location_checked(int object_id){
    return is_bestfriend(object_id);
}

bool is_bestfriend(int object_id){
    int global_manager = get_module("GlobalManager");
    int dispos_manager = get_module("DisposManager");
    int friend_id = @syscall(0,0x15,0xe,dispos_manager,object_id);
    int is_best_friend = @syscall(0,0x15,0x4b,global_manager,friend_id);
    return is_best_friend == 1;
}

void check_location(int object_id){
    set_bestfriend(object_id);
    return;
}

// stub out set_chapter
void set_chapter(int chapter){
    return;
}
