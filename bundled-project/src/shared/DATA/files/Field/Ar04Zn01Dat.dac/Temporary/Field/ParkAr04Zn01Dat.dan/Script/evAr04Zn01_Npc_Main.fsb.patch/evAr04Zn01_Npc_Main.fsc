void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    do_unlock_scenes(param_1);
    special_spawn_condition(param_1);
    gimmic_spawn_conditions(param_1);
    update_npc_story_state(param_1);
    return;
}

void A04_Z01_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    despawn_debug_prisma(0x4e23);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    SETGIMMICK(param_1);
    end_event_script(param_1);
    return;
}

void special_spawn_condition(int param_1){
    int global_manager = get_module("GlobalManager");

    const int CHATOT_OBJECT_ID = 0x102;
    spawn_object_if_missing(CHATOT_OBJECT_ID);
    set_object_position(CHATOT_OBJECT_ID,0x2d1,-0x2e,-0x1de);
    set_object_rotation_instantly(CHATOT_OBJECT_ID,0,10,0);
    reset_object_after_event(CHATOT_OBJECT_ID);

    return;
}

void gimmic_spawn_conditions(int param_1){
    int object_manager = get_module("ObjectManager");
    int global_manager = get_module("GlobalManager");
    int chapter = get_chapter();
    int has_bastiodon_prisma = @syscall(0,0x15,0x51,global_manager,9);

    if(has_bastiodon_prisma == 0){
        int object_spawned = @syscall(0,0x15,10,object_manager,0x4e39);
        if(object_spawned == 1){
            @syscall(0,0x15,0xd,object_manager,0x4e39);
        }

        object_spawned = @syscall(0,0x15,10,object_manager,0x4e3a);
        if(object_spawned == 1){
            @syscall(0,0x15,0xd,object_manager,0x4e3a);
        }
    }
    else{
        int object_accessor = @syscall(0,0x15,4,object_manager,0x4e35);
        object_accessor = @syscall(0,0x15,1,object_manager,object_accessor);
        @syscall(0,0x15,0,object_accessor,1);
    }

}

void RETURN_AT10(int param_1){
    const int BASTIODON_OBJECT_ID = 0xe8;

    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);

    setup_field(param_1);
    despawn_debug_prisma(0x4e23);
    despawn_player_object();
    wait_frames(1);
    spawn_player_object();
    set_player_at(0x170,-0x64,-0x3e4);
    set_player_rotation(0,0x105,0);
    @syscall(0,0x15,0xca,event_script,-1);

    int return_attraction = @syscall(0,0x15,1,global_manager,"fRetAttraction");
    if(return_attraction == 10){
        int has_bastiodon_prisma = @syscall(0,0x15,0x51,global_manager,9);
        if(has_bastiodon_prisma == 1){
            if(!is_location_checked(BASTIODON_OBJECT_ID)){
                bastiodon_friendship_scene(param_1);
            }
            else{
                int bastiodon_accessor = lock_npc_and_get_accessor(BASTIODON_OBJECT_ID);
                fade_in(0,0,0,0x1e);
                face_player_and_npc(BASTIODON_OBJECT_ID,0);
                @syscall(0,0x15,2,bastiodon_accessor,0x1b,10);
                @syscall(0,0x15,0x28,bastiodon_accessor,0x10fd,0,1.0,1.0);
                do_dialog_with_scene(param_1,BASTIODON_OBJECT_ID,"41_60333",0);
                reset_object_after_event(BASTIODON_OBJECT_ID);
                reset_camera();
                @syscall(0,0x15,0xca,event_script,0x1e);
            }
        }
        else{
            int bastiodon_accessor = lock_npc_and_get_accessor(BASTIODON_OBJECT_ID);
            fade_in(0,0,0,0x1e);
            face_player_and_npc(BASTIODON_OBJECT_ID,0);
            @syscall(0,0x15,2,bastiodon_accessor,0x1b,10);
            @syscall(0,0x15,0x28,bastiodon_accessor,0x10fd,0,1.0,1.0);
            do_dialog_with_scene(param_1,BASTIODON_OBJECT_ID,"41_60331",0);
            reset_object_after_event(BASTIODON_OBJECT_ID);
            reset_camera();
            @syscall(0,0x15,0xca,event_script,0x1e);
        }
    }

    fade_in(0,0,0,0x1e);
    clear_wand_check();
    restore_player_control();
    reset_camera();
    end_event_script(param_1);
    return;
}

void bastiodon_friendship_scene(int param_1){
    const int BASTIODON_OBJECT_ID = 0xe8;

    int event_script = get_module("EventScript");
    lock_player_and_get_accessor();

    vec3 camera_position = vec3{
        .x = 388.66,
        .y = -92.85,
        .z = -1006.87
    };
    vec3 camera_target = vec3{
        .x = 374.44,
        .y = -92.18,
        .z = -1000.90
    };
    @syscall(0,0x15,0xcb,event_script);
    @syscall(0,0x15,0xcc,event_script,-1,&camera_position);
    @syscall(0,0x15,0xcd,event_script,-1,&camera_target);

    fade_in(0,0,0,0x1e);
    int bastiodon_accessor = lock_npc_and_get_accessor(BASTIODON_OBJECT_ID);
    @syscall(0,0x15,2,bastiodon_accessor,0x1b,10);
    @syscall(0,0x15,0x28,bastiodon_accessor,0x10fd,0,1.0,1.0);
    do_dialog_with_scene(param_1,BASTIODON_OBJECT_ID,"41_60340",0);

    spawn_for_short_duration(0x4e23);
    wait_frames(0x6e);
    play_sound_effect(0x7ea,0);
    int field_info = get_module("mnFieldInfo");
    @syscall(0,0x15,0x11,field_info,1,"41_60350");
    wait_frames(0xb4);
    @syscall(0,0x15,0x12,field_info);
    wait_frames(0x1e);

    @syscall(0,0x15,2,bastiodon_accessor,0x1b,10);
    @syscall(0,0x15,0x28,bastiodon_accessor,0x10fd,0,1.0,1.0);
    do_dialog_with_scene(param_1,BASTIODON_OBJECT_ID,"41_60360",0);
    friendship_banner("41_00460");
    check_location(BASTIODON_OBJECT_ID);

    reset_object_after_event(BASTIODON_OBJECT_ID);
    reset_camera();
    @syscall(0,0x15,0xca,event_script,0x1e);
    wait_frames(0x23);
    @syscall(0,0x15,5,event_script);
    wait_frames(1);
    return;
}

void STAXIAREA(int param_1){
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int sound_manager = get_module("SoundManager");

    @syscall(0,0x15,100,event_script,0,0,0,0x3c);
    int destination = @syscall(0,0x15,1,global_manager,"rfFuwarideTaxi");
    @syscall(0,0x15,0x16,sound_manager,6,1.0);
    @syscall(0,0x15,0x16,sound_manager,8,1.0);
    @syscall(0,0x15,0x16,sound_manager,7,1.0);
    fade_out_sound(15);
    @syscall(0,0x15,400,event_script,3,0);

    if(destination == 0xb){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_MEADOW_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x15){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x1f){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x20){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x29){
        travel_to(4,1,2);
    }
    else if(destination == 0x2a){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x33){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x34){
        travel_to(5,2,0);
    }
    else if(destination == 0x3d){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x3e){
        travel_to(
            CAVERN_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_ZONE,
            CAVERN_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_AREA,
            CAVERN_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
}

