void diglett_dialog(int param_1){
    int object_id = 0xe4;
    int global_manager = get_module("GlobalManager");
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    @syscall(0,0x15,0x28,object_accessor,0xc3e,0,1.0,1.0);

    int has_prisma = @syscall(0,0x15,0x51,global_manager,0x9);
    if(has_prisma == 1){
        if(!is_location_checked(object_id)){
            show_npc_dialog(param_1,"41_60230");
            drop_held_item_animation();
            friendship_banner("41_00430");
            check_location(object_id);
        }
        else{
            show_npc_dialog(param_1,"41_60240");
        }
    }
    else{
        show_npc_dialog(param_1,"41_60240");
    }

    end_event_script(param_1);
}

