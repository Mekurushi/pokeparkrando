            "21_60130",
            "21_60140",
            "21_60150",
            "21_60120",
            0x15e,
            "f0201LevelEleboo",
            1
        );
        if(accepted == 1){
            @syscall(0,0x15,2,player_accessor,0x4c,5);
            play_sound_effect(0x7fd,0);
            show_message_box(1,"21_00390");
        }
    }
    else if(power_up_level == 1){
        int accepted = run_thunderbolt_shop_dialog(
            param_1,
            object_id,
            "21_60020",
            "21_60080",
            "21_60130",
            "21_60140",
            "21_60150",
            "21_60120",
            1000,
            "f0201LevelEleboo",
            2
        );
        if(accepted == 1){
            @syscall(0,0x15,2,player_accessor,0x4c,5);
            play_sound_effect(0x7fd,0);
            show_message_box(1,"21_00400");
        }
    }
    else if(power_up_level == 2){
        int accepted = run_thunderbolt_shop_dialog(
            param_1,
            object_id,
            "21_60030",
            "21_60090",
            "21_60130",
            "21_60140",
            "21_60150",
            "21_60120",
            0x5dc,
            "f0201LevelEleboo",
            3
        );
        if(accepted == 1){
            @syscall(0,0x15,2,player_accessor,0x4c,5);
            play_sound_effect(0x7fd,0);
            show_message_box(1,"21_00410");
        }
    }
    else if(power_up_level == 3){
        show_npc_dialog(param_1,"21_60060");
    }

    rotate_object(object_id,0,0xb3,0);
    end_event_script(param_1);
}

