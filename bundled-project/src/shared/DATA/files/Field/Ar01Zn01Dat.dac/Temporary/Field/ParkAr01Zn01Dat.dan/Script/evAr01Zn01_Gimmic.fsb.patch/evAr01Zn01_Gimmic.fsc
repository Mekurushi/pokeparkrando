extern int get_module(string name);
extern void fade_out(int red, int green, int blue, int frames);
extern void wait_frames(int frames);
extern void end_event_script(int param1);
extern void fade_out_bgm(int frames);
extern int lock_npc_and_get_accessor(int obj_id);
extern void fade_in_bgm(int frames);
extern void spawn_player_object();
extern void set_event_frame_visible_with_fade(int visible);
extern int object_id_to_friend_id(int object_id);
extern void fade_in(int red, int green, int blue, int frames);
extern void configure_npc(int object_id);
extern void restore_player_control();
extern void hide_event_frame(bool use_fade);
extern void reset_object_after_event(int object_id);
extern void despawn_field();
extern void play_sound_effect(int sound_id, int fade_in_frames);
extern void respawn_field();
extern void complete_event();
extern int lock_player_and_get_accessor();
extern void despawn_player_object();

int weedle_tree_gimmic_logic(int object_id){
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    get_module("ObjectManager");
    int field_info = get_module("mnFieldInfo");
    SysCall(0,0x15,0,global_manager,"f0101WeedleTree",1);
    wait_frames(30);

    vec3 player_position;
    vec3 player_rotation;
    int player = lock_player_and_get_accessor();
    SysCall(0,0x15,0x13,player,player_position);
    SysCall(0,0x15,0x16,player,player_rotation);

    fade_out_bgm(30);
    fade_out(0,0,0,60);
    despawn_field();
    configure_npc(object_id);

    int weedle = lock_npc_and_get_accessor(object_id);
    SysCall(0,0x15,7,weedle,395.68,46.09,-1469.44);
    SysCall(0,0x15,8,weedle,395.68,46.09,-1469.44);
    SysCall(0,0x15,0x1c,weedle,1);
    despawn_player_object();

    vec3 camera_position;
    vec3 camera_target;
    SysCall(3,2,camera_position,400.47,34.94,-1446.18);
    SysCall(3,2,camera_target,395.55,30.89,-1470.35);
    SysCall(0,0x15,0xcb,event_script);
    SysCall(0,0x15,0xcc,event_script,-1,camera_position);
    SysCall(0,0x15,0xcd,event_script,-1,camera_target);

    set_event_frame_visible_with_fade(0);
    SysCall(0,0x15,400,event_script,0,0);
    wait_frames(30);
    fade_in(0,0,0,30);
    play_sound_effect(0x7e7,0);
    SysCall(0,0x15,0x11,field_info,1,"11_00200");
    wait_frames(90);
    reset_object_after_event(object_id);
    wait_frames(90);
    SysCall(0,0x15,0x12,field_info);
    wait_frames(60);

    fade_out(0,0,0,60);hide_event_frame(false);
    wait_frames(30);
    respawn_field();
    SysCall(0,0x15,400,event_script,0,1);

    spawn_player_object();
    player = lock_player_and_get_accessor();
    SysCall(0,0x15,7,player,player_position.x,player_position.y,player_position.z);
    SysCall(0,0x15,8,player,player_position.x,player_position.y,player_position.z);
    SysCall(0,0x15,0x22,player,player_position.x,player_position.y,player_position.z,1);
    SysCall(0,0x15,9,player,player_rotation.x,player_rotation.y,player_rotation.z);

    int player_state = SysCall(0,0x15,0x30,player);
    if(player_state == 0){
        SysCall(0,0x15,2,player,0,0);
    }
    SysCall(0,0x15,0,player,0);
    SysCall(0,0x15,0xca,event_script,-1);
    fade_in_bgm(30);
    complete_event();
    fade_in(0,0,0,30);
    return 1;
}

void TREEBEEDLE(int param_1){
    int dispos_manager = get_module("DisposManager");
    int global_manager = get_module("GlobalManager");

    int is_location_checked = SysCall(0,0x15,1,global_manager,"f0101WeedleTree");
    if(is_location_checked == 0){
        lock_player_and_get_accessor();
        weedle_tree_gimmic_logic(0xe);
        restore_player_control();
    }

    SysCall(0,0x15,0,global_manager,"zfTreeBeedle",1);
    end_event_script(param_1);
    return;
}

void TREE_CATAPI(int param_1){
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    int field_info = get_module("mnFieldInfo");
    get_module("ObjectManager");

    int is_loc_checked = SysCall(0,0x15,1,global_manager,"f0101CaterpieTree");
    if(is_loc_checked == 0){
        SysCall(0,0x15,0,global_manager,"f0101CaterpieTree",1);
        wait_frames(30);

        vec3 player_position;
        vec3 player_rotation;
        int player = lock_player_and_get_accessor();
        SysCall(0,0x15,0x13,player,player_position);
        SysCall(0,0x15,0x16,player,player_rotation);

        fade_out_bgm(30);
        fade_out(0,0,0,60);
        despawn_field();
        configure_npc(0xd);

        int caterpie = lock_npc_and_get_accessor(0xd);
        SysCall(0,0x15,7,caterpie,-68.27,20.0,-1168.46);
        SysCall(0,0x15,8,caterpie,-68.27,20.0,-1168.46);
        SysCall(0,0x15,0x1c,caterpie,1);
        SysCall(0,0x15,9,caterpie,0.0,125.0,0.0);

        despawn_player_object();
        set_event_frame_visible_with_fade(0);
        
        SysCall(0,0x15,400,event_script,0,0);

        vec3 camera_position;
        vec3 camera_target;
        SysCall(3,2,camera_position,-55.97,7.74,-1184.04);
        SysCall(3,2,camera_target,-71.67,3.73,-1164.28);
        SysCall(0,0x15,0xcb,event_script);
        SysCall(0,0x15,0xcc,event_script,-1,camera_position);
        SysCall(0,0x15,0xcd,event_script,-1,camera_target);

        fade_in(0,0,0,30);
        play_sound_effect(0x7e7,0);
        SysCall(0,0x15,0x11,field_info,1,"11_00190");
        wait_frames(180);
        SysCall(0,0x15,0x12,field_info);
        wait_frames(60);

        fade_out(0,0,0,60);
        hide_event_frame(false);
        reset_object_after_event(0xd);
        SysCall(0,0x15,0x15,caterpie,0);
        wait_frames(30);
        respawn_field();
        SysCall(0,0x15,400,event_script,0,1);
        fade_in_bgm(30);
        complete_event();

        spawn_player_object();
        player = lock_player_and_get_accessor();
        SysCall(0,0x15,7,player,player_position.x,player_position.y,player_position.z);
        SysCall(0,0x15,8,player,player_position.x,player_position.y,player_position.z);
        SysCall(0,0x15,0x22,player,player_position.x,player_position.y,player_position.z,1);
        SysCall(0,0x15,9,player,player_rotation.x,player_rotation.y,player_rotation.z);

        int player_state = SysCall(0,0x15,0x30,player);
        if(player_state == 0){
            SysCall(0,0x15,2,player,0,0);
        }
        SysCall(0,0x15,0,player,0);
        SysCall(0,0x15,0xca,event_script,-1);
        fade_in(0,0,0,30);
        restore_player_control();
    }

    SysCall(0,0x15,0,global_manager,"zfTreeCatapi",1);
    end_event_script(param_1);
    return;
}
