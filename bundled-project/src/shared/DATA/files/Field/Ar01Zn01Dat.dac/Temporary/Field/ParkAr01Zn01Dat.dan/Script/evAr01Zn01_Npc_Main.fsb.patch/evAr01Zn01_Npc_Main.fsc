void special_spawn_condition(int param1){

    int global_manager = get_module("GlobalManager");
    int disp_manager = get_module("DisposManager");
    int spawn_gimmick_magikarp = SysCall(0, 0x15, 0x1, global_manager, "MagikarpRescued");

    if(spawn_gimmick_magikarp == 0) {
        int obj_manager = get_module("ObjectManager");
        int is_gimmick_magikarp_spawned = SysCall(0,0x15,10,obj_manager,0x36);
        if (is_gimmick_magikarp_spawned == 0) {
            SysCall(0,0x15,0x11,obj_manager,0x36);
        }
        int gimmick_magikarp_obj = configure_npc_and_get_accessor(0x36);
        SysCall(0,0x15,0x2714,gimmick_magikarp_obj,1);
        SysCall(0,0x15,0x15,gimmick_magikarp_obj,0);
    }
    else{
        despawn(0x36);
    }
    return;
}

