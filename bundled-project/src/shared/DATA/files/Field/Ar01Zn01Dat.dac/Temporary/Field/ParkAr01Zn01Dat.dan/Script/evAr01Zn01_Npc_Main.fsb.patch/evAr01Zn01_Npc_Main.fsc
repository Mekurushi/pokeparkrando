void event_bidoof_dialog(int param_1){
    int object_id = 0xf;
    int player = freeze_player();
    int object_accessor = configure_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    SysCall(0,0x15,0x28,object_accessor,0xa40,0,0x3f800000,0x3f800000);

    if (is_friend(0x14) == 0){
    // if mankey is not befriended abort dialog
        show_npc_dialog(param_1,"11_90100");
        end_event_script(param_1);
    }
    // vec3 commented out until supported

    //vec3 object_position;
    //vec3 object_rotation;
    //SysCall(0,0x15,0x13,object_accessor,SysCall(3,1,object_position));
    //SysCall(0,0x15,0x16,object_accessor,SysCall(3,1,object_rotation));

    //TODO: beach_bidoof unlock
    
    int gf0004 = SysCall(0,0x15,1,global_manager,"GF0004");
    if(gf0004 > 3){
        show_npc_dialog(param_1,"11_90091");
        end_event_script(param_1);
    }
    
    int gf0005 = SysCall(0,0x15,1,global_manager,"GF0005");
    if (gf0005 == 0){
        show_npc_dialog(param_1,"11_90000");
        SysCall(0,0x15,0,global_manager,"GF0005",1);
    }

    int item_kind = get_held_item_kind();
    if(item_kind == 1){
        if (gf0004 == 0){
            show_npc_dialog(param_1,"11_90020");
        }
        else if (gf0004 == 1){
            show_npc_dialog(param_1,"11_90040");
        }
        else if (gf0004 == 2){
            show_npc_dialog(param_1,"11_90060");
        }
        else if (gf0004 == 3){
            show_npc_dialog(param_1,"11_90080");
        }
        else{
            show_npc_dialog(param_1,"01_00001");
        }
    }
    else {
        if (gf0004 == 0){
            show_npc_dialog(param_1,"11_90010");
        }
        else if (gf0004 == 1){
            show_npc_dialog(param_1,"11_90030");
        }
        else if (gf0004 == 2){
            show_npc_dialog(param_1,"11_90050");
        }
        else if (gf0004 == 3){
            show_npc_dialog(param_1,"11_90070");
        }
        else{
            show_npc_dialog(param_1,"01_00001");
        }
        end_event_script(param_1);
    }
    FUN_00051500(0x3c);
    FUN_00051e9c(0,0,0,0x3c);
    int increased_gf0004 = gf0004 + 1;
    SysCall(0,0x15,0,global_manager,"GF0004", increased_gf0004);
    SysCall(0,0x15,0xca,event_script,0);

    //vec3 player_position;
    //vec3 player_rotation;
    //SysCall(0,0x15,0x13,player,SysCall(3,1,player_position));
    //SysCall(0,0x15,0x16,player,SysCall(3,1,player_rotation));

    remove_held_item();
    despawn_player_object();
    spawn_player_object();
    freeze_player();

    if(increased_gf0004 == 1){
        EA01_Z01_D04(param_1);
    } else if(increased_gf0004 == 2){
        EA01_Z01_D05(param_1);
    } else if(increased_gf0004 == 3){
        EA01_Z01_D06(param_1);
    } else if(increased_gf0004 == 4){
        EA01_Z01_D07(param_1);
    }
    remove_held_item();
    player = freeze_player();
    //SysCall(0,0x15,1,player,0);
    //SysCall(0,0x15,7,player,player_position.x,player_position.y,player_position.z);
    //SysCall(0,0x15,8,player,player_position.x,player_position.y,player_position.z);
    //SysCall(0,0x15,0x22,player,player_position.x,player_position.y,player_position.z,1);
    //SysCall(0,0x15,9,player,player_rotation.x,player_rotation.y,player_rotation.z);

    int updated_gf0004 = SysCall(0,0x15,1,global_manager,"GF0004");

    //TODO: replace with location checks
    if(updated_gf0004==1){
        unlock_pokemon(0x23);
    } else if(updated_gf0004==2){
        unlock_pokemon(0x24);
    } else if(updated_gf0004==3){
        unlock_pokemon(0x25);
    }
    respawn_field();
    special_spawn_condition(param_1);
    object_accessor = configure_npc_and_get_accessor(object_id);
    //SysCall(0,0x15,7,object_accessor,object_position.x,object_position.y,object_position.z);
    //SysCall(0,0x15,9,object_accessor,object_rotation.x,object_rotation.y,object_rotation.z);

    face_object_accessors(player,object_accessor,1);
    FUN_00051500(0x3c);
    FUN_000500c8(0,0,0,0x3c);
    SysCall(0,0x15,0x28,object_accessor,0xa40,0,0x3f800000,0x3f800000);

    if (updated_gf0004 == 1) {
    show_npc_dialog(param_1,"11_90030");
  }
  else if (updated_gf0004 == 2) {
    show_npc_dialog(param_1,"11_90050");
  }
  else if (updated_gf0004 == 3) {
    show_npc_dialog(param_1,"11_90070");
  }
  else if (updated_gf0004 == 4) {
    show_npc_dialog(param_1,"11_90090");
    unlock_pokemon(0x1b);
    SysCall(0,0x15,0,global_manager,"f0101BippaFlag",1);
  }
  else {
    show_npc_dialog(param_1,"01_00001");
  }

  if (3 < updated_gf0004) {
  //TODO: check friendship location
    friendship_banner("11_00490");

    SysCall(0,0x15,0x14,global_manager,100);
    FUN_00050124(0,0,0,0x3c);
    complete_event();
  }
  end_event_script(param_1);
    return;
}

