void AR01ZN01_INI(int param_1){
    // activate logs
    SysCall(0,7,1);

    int event_script = get_module("EventScript");
    SysCall(0,0x15,0x65,event_script,0,0,0,1);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
    return;
}

void AR01ZN01_DEF(int param_1){
    // activate logs
    SysCall(0,7,1);

    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
    return;
}

void do_unlock_scenes(int param_1){
    int global_manager = get_module("GlobalManager");
    if(has_wand_check() == 1){
        fade_out(0,0,0,60);
    }

    // Pachirisu
    if(SysCall(0,0x15,0x29,global_manager,4) == 1){
        show_unlock_cutscene_at_position(param_1,7,"11_00140",0,0,-80.0,-16.0,-650.0);
    }

    // Chimchar
    if(SysCall(0,0x15,0x29,global_manager,7) == 1){
        show_unlock_cutscene_at_position(param_1,10,"11_00160",0,0,336.9,23.0,-1075.0);
    }
    
    // magikarp
    if(SysCall(0,0x15,0x29,global_manager,0x8) == 1){
        show_unlock_cutscene_at_position(param_1,0xb,"11_00170",0,0,784.0,24.0,-1415.0);
    }

    // Lotad
    if(SysCall(0,0x15,0x29,global_manager,9) == 1){
        show_unlock_cutscene_at_position(param_1,0xc,"11_00180",0,0,-89.5,-7.0,-836.9);
    }

    // caterpie
    if(SysCall(0,0x15,0x29,global_manager,10) == 1){
        show_unlock_cutscene_at_position(param_1,0xd,"11_00190",0,0,-68.27,20.0,-1168.46);
    }

    // Weedle
    if(SysCall(0,0x15,0x29,global_manager, 0xb) == 1){
        show_unlock_cutscene_at_position(param_1,0xe,"11_00200",0,0,395.68,46.09,-1469.44);
    }

    // Shroomish
    if(SysCall(0,0x15,0x29,global_manager,0xe) == 1){
        show_unlock_cutscene_at_position(param_1,0x11,"11_00220",0,0, 949.0, 24.0, -1314.0);
    }

    // Bonsly
    if(SysCall(0,0x15,0x29,global_manager,0xf) == 1){
        show_unlock_cutscene_at_position(param_1,0x12,"11_00230",0,0,-80.0,-16.0,-650.0);
    }

    // Shinx
    if(SysCall(0,0x15,0x29,global_manager,0x10) == 1){
        show_unlock_cutscene_at_position(param_1,0x13,"11_00240",0,0,424.6,23.0,-619.0);
    }

    // Butterfree
    if(SysCall(0,0x15,0x29,global_manager,0x16) == 1){
        show_unlock_cutscene_at_position(param_1,0x19,"11_00300",10,0,-89.5,-7.0,-836.9);
    }

    // Tropius
    if(SysCall(0,0x15,0x29,global_manager,0x17) == 1){
        show_unlock_cutscene_at_position(param_1,0x1a,"11_00310",30,0,336.9,23.0,-1075.0);
    }

    // Bibarel
    if(SysCall(0,0x15,0x29,global_manager,0x18) == 1){
        show_unlock_cutscene_at_current_position(param_1,0x1b,"11_00320",10,0);
    }

    // Ambipom
    if(SysCall(0,0x15,0x29,global_manager,0x19) == 1){
        show_unlock_cutscene_at_position(param_1,0x1c,"11_00330",10,0,-33.0,-1.0,-1566.5);
    }

    // Sudowoodo
    if(SysCall(0,0x15,0x29,global_manager,0x57) == 1){
        show_unlock_cutscene_at_position(param_1,0x1d,"11_00340",10,0,-481.6,14.0,-775.8);
    }

    // Scyther
    if(SysCall(0,0x15,0x29,global_manager,0x1b) == 1){
        show_unlock_cutscene_at_position(param_1,0x1e,"11_00350",20,0,-481.6,14.0,-775.8);
    }

    int event_script = get_module("EventScript");
    SysCall(0,0x15,400,event_script,0,1);
    int audio_state = SysCall(0,0x15,0x1f7,event_script,0x17e0);

    if(audio_state == 0){
        fade_in_bgm(30);
    }
    return;
}

void cleared_prisma_goal_dialog(int param_1){
    int bulbasaur_object_id = 0x21;
    int global_manager = get_module("GlobalManager");
    int npc_accessor = get_object_accessor(param_1,0x21,true);
    int has_bulbasaur_prisma = SysCall(0,0x15,0x51,global_manager,0xf);
    if(has_bulbasaur_prisma == 1){
        point_camera_between(0,0x21);
        SysCall(0,0x15,2,npc_accessor,0x1c,10);
        SysCall(0,0x15,0x28,npc_accessor,0xc8a,0,1.0,1.0);
        do_dialog_with_scene(param_1,0x21,"11_60070",0);
        spawn_for_short_duration(0x4e23);
        wait_frames(0x6e);
        play_sound_effect(0x7ea,0);

        int field_info = get_module("mnFieldInfo");
        SysCall(0,0x15,0x11,field_info,1,"11_60071");
        wait_frames(0xb4);
        SysCall(0,0x15,0x12,field_info);

        SysCall(0,0x15,2,npc_accessor,0x1b,10);
        SysCall(0,0x15,0x28,npc_accessor,0xc89,0,1.0,1.0);
        do_dialog_with_scene(param_1,0x21,"11_60072",0);
        friendship_banner("11_00662");
        check_location(bulbasaur_object_id);
        reset_camera();
        SETMUFFINBOX();
    }
    return;
}

// RETURN_AT
void RETURN_AT(int param_1){
    int bulbasaur_object_id = 0x21;
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    SysCall(0,0x15,0x65,event_script,0,0,0,1);

    setup_field(param_1);

    int player = lock_player_and_get_accessor();
    set_player_at(-38,-19,-590);
    int npc_accessor = get_object_accessor(param_1,0x21,true);
    face_object_accessors_instantly(player,npc_accessor,1);
    SysCall(0,0x15,0xca,event_script,-1);

    vec3 camera_position; // names are wild guesses
    vec3 camera_target;
    SysCall(3,2,SysCall(3,1,camera_position),-61.3,-9.75,-579.8);
    SysCall(3,2,SysCall(3,1,camera_target),-9.46,-14.56,-614.73);
    SysCall(0,0x15,0xcb,event_script);
    SysCall(0,0x15,0xcc,event_script,-1,SysCall(3,1,camera_position));
    SysCall(0,0x15,0xcd,event_script,-1,SysCall(3,1,camera_target));

    int should_face_npc = SysCall(0,0x15,0x67,event_script);
    if(should_face_npc == 1){
        face_object_accessors_instantly(player,npc_accessor,1);
    }
    fade_in(0,0,0,0x1e);

    int return_attraction = SysCall(0,0x15,1,global_manager,"fRetAttraction");
    if(return_attraction == 0x10){
        lock_npc_and_get_accessor(0x21);
        int has_bulbasaur_prisma = SysCall(0,0x15,0x51,global_manager,0xf);

        if(has_bulbasaur_prisma == 1){
            if(!is_location_checked(bulbasaur_object_id)){
                cleared_prisma_goal_dialog(param_1);
                reset_object_after_event(0x21);
                reset_camera();
                SysCall(0,0x15,0xca,event_script,0x1e);
                wait_frames(0x1e);
            }
            else{
                point_camera_between(0,0x21);
                SysCall(0,0x15,2,npc_accessor,0x1b,10);
                SysCall(0,0x15,0x28,npc_accessor,0xc89,0,1.0,1.0);
                do_dialog_with_scene(param_1,0x21,"11_60063",0);
                reset_object_after_event(0x21);
                reset_camera();
                SysCall(0,0x15,0xca,event_script,0x1e);
                wait_frames(0x1e);
            }
        }
        else if(has_bulbasaur_prisma == 0){
            point_camera_between(0,0x21);
            SysCall(0,0x15,2,npc_accessor,0x1b,10);
            SysCall(0,0x15,0x28,npc_accessor,0xc89,0,1.0,1.0);

            do_dialog_with_scene(param_1,0x21,"11_60061",0);

            SysCall(0,0x15,0xca,event_script,0x1e);
            wait_frames(0x1e);
            reset_object_after_event(0x21);
            reset_camera();
        }
    }

    restore_player_control();
    reset_camera();
    end_event_script(param_1);
    return;
}

void STAXIAREA(int param_1){
    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    int sound_manager = get_module("SoundManager");

    SysCall(0,0x15,100,event_script,0,0,0,0x3c);
    int destination = SysCall(0,0x15,1,global_manager,"rfFuwarideTaxi");
    SysCall(0,0x15,0x16,sound_manager,6,1.0);
    SysCall(0,0x15,0x16,sound_manager,8,1.0);
    SysCall(0,0x15,0x16,sound_manager,7,1.0);
    fade_out_sound(15);
    SysCall(0,0x15,400,event_script,3,0);

    if(destination == 0xb){
        travel_to(1,1,3);
    }
    else if(destination == 0x15){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_TREEHOUSE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x1f){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_BEACH_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x20){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_ICE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x29){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_CAVERN_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x2a){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_MAGMA_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x33){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_HAUNTED_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x34){
        travel_to(5,2,0);
    }
    else if(destination == 0x3d){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_GRANITE_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
    else if(destination == 0x3e){
        travel_to(
            MEADOW_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_ZONE,
            MEADOW_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_AREA,
            MEADOW_ZONE_MAIN_AREA_FLOWER_DRIFBLIM_FAST_TRAVEL_POSITION
        );
    }
}

void special_spawn_condition(int param1){

    int global_manager = get_module("GlobalManager");
    int disp_manager = get_module("DisposManager");
    bool spawn_gimmick_magikarp = is_location_checked(0x36);

    if(spawn_gimmick_magikarp == false) {
        int obj_manager = get_module("ObjectManager");
        int is_gimmick_magikarp_spawned = SysCall(0,0x15,10,obj_manager,0x36);
        if (is_gimmick_magikarp_spawned == 0) {
            SysCall(0,0x15,0x11,obj_manager,0x36);
        }
        int gimmick_magikarp_obj = lock_npc_and_get_accessor(0x36);
        SysCall(0,0x15,0x2714,gimmick_magikarp_obj,1);
        SysCall(0,0x15,0x15,gimmick_magikarp_obj,0);
    }
    else{
        despawn(0x36);
    }
    return;
}

