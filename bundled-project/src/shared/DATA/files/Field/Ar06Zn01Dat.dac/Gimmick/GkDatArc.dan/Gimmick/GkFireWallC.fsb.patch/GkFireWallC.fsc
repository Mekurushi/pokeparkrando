extern int get_module(string name);

export void RUN(int param_1){
    int global_manager = get_module("GlobalManager");
    int object_manager = get_module("ObjectManager");
    int object_id = @syscall(0,0x15,0,param_1);
    @syscall(0,0x15,1,object_manager,object_id);

    int object = @syscall(0,0x15,4,param_1);
    @syscall(0,0x15,0,object,param_1,0);
    int effect_accessor = @syscall(0,0x15,7,param_1);
    int transform_accessor = @syscall(0,0x15,8,param_1);
    int animation_accessor = @syscall(0,0x15,6,param_1);

    int firewall_enabled = @syscall(0,0x15,1,global_manager,"f0601FireWallB");
    if(firewall_enabled == 0){
        @syscall(0,0x15,5,effect_accessor,0x501e0000,transform_accessor,-20.0,0,0,0);
        @syscall(0,0x15,5,effect_accessor,0x501e0000,transform_accessor,0.0,0,0,0);
        @syscall(0,0x15,5,effect_accessor,0x501e0000,transform_accessor,20.0,0,0,0);
        @syscall(0,0x15,2,animation_accessor,param_1,0x756,0,1.0,1.0);

        // re-enabling hitbox when the firewall is enabled again
        int internal_component = @syscall(0,0x15,0x1e,param_1);
        @syscall(0,0x15,4,internal_component,0,0);
    }
    else{
        int internal_component = @syscall(0,0x15,0x1e,param_1);
        @syscall(0,0x15,4,internal_component,1,0);
    }
}

export void STOP(int param_1){
    int object_manager = get_module("ObjectManager");
    int object_handle = @syscall(0,0x15,0,param_1);
    int object_accessor = @syscall(0,0x15,1,object_manager,object_handle);
    int effect_accessor = @syscall(0,0x15,7,param_1);

    @pause(0x46);
    @syscall(0,0x15,0xc,effect_accessor,0x501e0000,0);
    @syscall(0,0x15,0,object_accessor,2);

    int animation_accessor = @syscall(0,0x15,6,param_1);
    @syscall(0,0x15,4,animation_accessor,0x756,0);
}
