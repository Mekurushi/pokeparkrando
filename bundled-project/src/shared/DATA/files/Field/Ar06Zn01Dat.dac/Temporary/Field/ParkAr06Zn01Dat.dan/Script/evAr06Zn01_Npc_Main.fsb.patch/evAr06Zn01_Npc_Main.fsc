// eA06_Z01_22
void salamence_dialog(int param_1){
    const int SALAMENCE_OBJECT_ID = 0x1b6;
    const int FRIENDSHIP_COUNT = 80;
    const int ATTRACTION_FEE = 40;

    int global_manager = get_module("GlobalManager");
    int player_accessor = lock_player_and_get_accessor();
    int salamence_accessor = lock_npc_and_get_accessor(SALAMENCE_OBJECT_ID);
    face_player_and_npc(SALAMENCE_OBJECT_ID,0);
    @syscall(0,0x15,2,salamence_accessor,0x1b,10);
    @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);

    int friendship_count = @syscall(0,0x15,0x42,global_manager);
    if(friendship_count < FRIENDSHIP_COUNT){
        show_npc_dialog(param_1,"61_60351");
        end_event_script(param_1);
        return;
    }

    if(is_location_checked(SALAMENCE_OBJECT_ID)){
        show_npc_dialog(param_1,"61_60360");
    }
    else{
        show_npc_dialog(param_1,"61_60370");
    }

    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"61_60380");
    if(wants_to_enter == 1){
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < ATTRACTION_FEE){
            @syscall(0,0x15,2,salamence_accessor,0x1b,10);
            @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
            show_npc_dialog(param_1,"61_60410");
        }
        else{
            @syscall(0,0x15,2,salamence_accessor,0x1c,10);
            @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
            show_npc_dialog(param_1,"61_60400");
            @syscall(0,0x15,0,global_manager,"fRetAttraction",0xf);
            set_berry_counter_visible(false);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,GRANITE_ZONE_MAIN_AREA_SALAMENCE_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,salamence_accessor,0x1b,10);
        @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
        show_npc_dialog(param_1,"61_60390");
    }

    set_berry_counter_visible(false);
    end_event_script(param_1);
}

void RETURN_AT15(int param_1){
    const int SALAMENCE_OBJECT_ID = 0x1b6;

    int global_manager = get_module("GlobalManager");
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);

    setup_field(param_1);
    despawn_debug_prisma(0x4e21);
    despawn_debug_prisma(0x4e22);
    despawn_player_object();
    wait_frames(1);
    spawn_player_object();
    lock_player_and_get_accessor();
    set_player_at(-1326,140,-1469);
    face_player_towards_object_synchronously(SALAMENCE_OBJECT_ID,0);
    @syscall(0,0x15,0xca,event_script,-1);

    int has_salamence_prisma = @syscall(0,0x15,0x51,global_manager,0xe);
    if(has_salamence_prisma == 1){
        if(!is_location_checked(SALAMENCE_OBJECT_ID)){
            salamence_friendship_scene(param_1);
        }
        else{
            int salamence_accessor = lock_npc_and_get_accessor(SALAMENCE_OBJECT_ID);
            fade_in(0,0,0,0x1e);
            face_player_and_npc(SALAMENCE_OBJECT_ID,0);
            @syscall(0,0x15,2,salamence_accessor,0x1b,10);
            @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
            do_dialog_with_scene(param_1,SALAMENCE_OBJECT_ID,"61_60450",0);
            reset_object_after_event(SALAMENCE_OBJECT_ID);
            reset_camera();
            @syscall(0,0x15,0xca,event_script,0x1e);
        }
    }
    else{
        int salamence_accessor = lock_npc_and_get_accessor(SALAMENCE_OBJECT_ID);
        fade_in(0,0,0,0x1e);
        face_player_and_npc(SALAMENCE_OBJECT_ID,0);
        @syscall(0,0x15,2,salamence_accessor,0x1b,10);
        @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
        do_dialog_with_scene(param_1,SALAMENCE_OBJECT_ID,"61_60430",0);
        reset_object_after_event(SALAMENCE_OBJECT_ID);
        reset_camera();
        @syscall(0,0x15,0xca,event_script,0x1e);
    }

    complete_event();
    fade_in(0,0,0,0x1e);
    reset_object_after_event(SALAMENCE_OBJECT_ID);
    clear_wand_check();
    end_event_script(param_1);
}

void salamence_friendship_scene(int param_1){
    const int SALAMENCE_OBJECT_ID = 0x1b6;

    int event_script = get_module("EventScript");
    int player_accessor = lock_player_and_get_accessor();
    int salamence_accessor = lock_npc_and_get_accessor(SALAMENCE_OBJECT_ID);

    vec3 camera_position = vec3{
        .x = -1305.56,
        .y = 146.0,
        .z = -1454.12
    };
    vec3 camera_target = vec3{
        .x = -1341.58,
        .y = 151.9,
        .z = -1471.5
    };
    @syscall(0,0x15,0xcb,event_script);
    @syscall(0,0x15,0xcc,event_script,-1,&camera_position);
    @syscall(0,0x15,0xcd,event_script,-1,&camera_target);

    face_object_accessors_instantly(player_accessor,salamence_accessor,1);
    fade_in(0,0,0,0x3c);
    wait_frames(0x1e);
    @syscall(0,0x15,2,salamence_accessor,0x1c,10);
    @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
    do_dialog_with_scene(param_1,SALAMENCE_OBJECT_ID,"61_60460",0);

    spawn_for_short_duration(0x4e22);
    wait_frames(0x6e);
    play_sound_effect(0x7ea,0);
    int field_info = get_module("mnFieldInfo");
    @syscall(0,0x15,0x11,field_info,1,"61_60470");
    wait_frames(0xb4);
    @syscall(0,0x15,0x12,field_info);
    wait_frames(0x1e);

    @syscall(0,0x15,2,salamence_accessor,0x1b,10);
    @syscall(0,0x15,0x28,salamence_accessor,0x1265,0,1.0,1.0);
    do_dialog_with_scene(param_1,SALAMENCE_OBJECT_ID,"61_60480",0);
    friendship_banner("61_00460");
    check_location(SALAMENCE_OBJECT_ID);

    reset_object_after_event(SALAMENCE_OBJECT_ID);
    @syscall(0,0x15,0xca,event_script,0x1e);
    wait_frames(0x23);
    reset_camera();
}

