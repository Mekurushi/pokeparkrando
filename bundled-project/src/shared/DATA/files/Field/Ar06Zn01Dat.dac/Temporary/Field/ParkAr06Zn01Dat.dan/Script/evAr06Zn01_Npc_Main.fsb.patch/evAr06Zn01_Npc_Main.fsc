string get_quiz_dialog_id(int quiz_id, int kind, int index){
    if(quiz_id == 0){
    if(kind == QUIZ_DIALOG_INTRO){
        if(index == 0){ return "61_12060"; }
        return "61_12100";
    }
    if(kind == QUIZ_DIALOG_ROUND_INTRO){
        if(index == 0){ return "61_60250"; }
        if(index == 1){ return "61_60220"; }
        if(index == 2){ return "61_12140"; }
        return "61_12120";
    }
    if(kind == QUIZ_DIALOG_CORRECT){ return "61_12140"; }
    return "61_12150";
    }
    return "";
}
