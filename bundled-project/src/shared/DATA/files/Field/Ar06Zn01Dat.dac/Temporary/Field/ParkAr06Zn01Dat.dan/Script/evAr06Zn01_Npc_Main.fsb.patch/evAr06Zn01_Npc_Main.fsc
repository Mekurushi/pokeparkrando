void special_spawn_conditions(int param_1){
    const int CHATOT_OBJECT_ID = 0x1ba;

    spawn_object_if_missing(CHATOT_OBJECT_ID);
    set_object_position(CHATOT_OBJECT_ID,-100,0,192);
    set_object_rotation_instantly(CHATOT_OBJECT_ID,0,91,0);
}

void do_unlock_scenes(int param_1){
    int global_manager = get_module("GlobalManager");

    if(has_wand_check() == 1){
        fade_out(0,0,0,0x3c);
    }

    // Aerodactyl
    if(@syscall(0,0x15,0x29,global_manager,0xb4) == 1){
        show_unlock_cutscene_at_position(param_1,0x1a9,"61_00180",0x1e,1,-846.0,140.0,-1442.79);
    }

    // Jolteon
    if(@syscall(0,0x15,0x29,global_manager,0x8d) == 1){
        show_unlock_cutscene_at_position(param_1,0x1b4,"61_00200",10,0,-846.0,140.0,-1442.79);
    }

    // Claydol
    if(@syscall(0,0x15,0x29,global_manager,0x65) == 1){
        show_unlock_cutscene_at_position(param_1,0x1a4,"61_00170",10,0,71.5,110.0,-840.29);
    }

    // Garchomp
    if(@syscall(0,0x15,0x29,global_manager,0x85) == 1){
        // TODO: create proper unlock text
        show_unlock_cutscene_at_current_position(param_1,0x1a5,"61_00040",10,0);
    }

    // Tyranitar
    if(@syscall(0,0x15,0x29,global_manager,0x86) == 1){
        // TODO: create proper unlock text
        show_unlock_cutscene_at_current_position(param_1,0x1a6,"61_00050",10,0);
    }

    // Baltoy
    if(@syscall(0,0x15,0x29,global_manager,0x9d) == 1){
        // TODO: create proper unlock text
        show_unlock_cutscene_at_current_position(param_1,0x1a7,"61_00060",10,0);
    }

    // Drifblim
    if(@syscall(0,0x15,0x29,global_manager,0x1f) == 1){
        show_unlock_cutscene_at_current_position(param_1,0x1b8,"61_00230",10,0);
    }

    // Jirachi
    if(@syscall(0,0x15,0x29,global_manager,0xa6) == 1){
        // TODO: create proper unlock text
        show_unlock_cutscene_at_current_position(param_1,0x1bb,"61_00080",10,0);
    }

    int event_script = get_module("EventScript");
    @syscall(0,0x15,400,event_script,0,1);
    int audio_state = @syscall(0,0x15,0x1f7,event_script,0x17ea);
    if(audio_state == 0){
        fade_in_bgm(0x1e);
    }
}

void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    do_unlock_scenes(param_1);
    special_spawn_conditions(param_1);
    update_npc_story_state(param_1);
}

void A06_Z01_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    despawn_debug_prisma(0x4e21);
    despawn_debug_prisma(0x4e22);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

void AR06ZN01_DEF(int param_1){
    despawn_debug_prisma(0x4e21);
    despawn_debug_prisma(0x4e22);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
}

 // eA06_Z01_00
void skorupi1_dialog(int param_1){
    const int object_id = 0x1a0;
    int global_manager = get_module("GlobalManager");
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);
    @syscall(0,0x15,0x28,object_accessor,0xac7,0,1.0,1.0);

    if(@syscall(0,0x15,1,global_manager,"f0601FireWallB") == 1){
        if(!is_location_checked(object_id)){
            show_npc_dialog(param_1,"61_10090");
            friendship_banner("61_00240");
            check_location(object_id);
        }
        else{
            show_npc_dialog(param_1,"61_10001");
        }
    }
    else{
        show_npc_dialog(param_1,"61_10000");
    }
    end_event_script(param_1);
}

