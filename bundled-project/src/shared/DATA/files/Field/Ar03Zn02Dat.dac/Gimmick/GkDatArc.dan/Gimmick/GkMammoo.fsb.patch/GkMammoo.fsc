extern int get_module(string name);

export void STEP1(int param_1){
  int dispos_manager = get_module("DisposManager");
  @syscall(0,0x15,4,dispos_manager,0xb6);

  int global_manager = get_module("GlobalManager");
  int is_revived = @syscall(0,0x15,1,global_manager,"f0302MamoswineRevived");
  if(is_revived == 0){
    int object = @syscall(0,0x15,4,param_1);
    @syscall(0,0x15,0,object,param_1,0);
  }
  else{
    int object = @syscall(0,0x15,5,param_1);
    @syscall(0,0x15,0,object,param_1,6);
  }
  return;
}
