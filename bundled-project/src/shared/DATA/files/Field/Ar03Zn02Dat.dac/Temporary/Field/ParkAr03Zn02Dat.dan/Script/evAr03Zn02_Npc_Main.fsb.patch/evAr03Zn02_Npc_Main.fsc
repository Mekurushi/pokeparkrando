void A03_Z02_INIT(int param_1){
    int event_script = get_module("EventScript");
    @syscall(0,0x15,0x65,event_script,0,0,0,1);
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
    return;
}

void A03_Z02_REP(int param_1){
    setup_field(param_1);
    fade_in(0,0,0,0x1e);
    clear_wand_check();
    end_event_script(param_1);
    return;
}

void setup_field(int param_1){
    lock_player_and_get_accessor();
    setup_player_for_zone();
    SETITEMS(param_1);
    do_unlock_scenes(param_1);
    special_spawn_condition(param_1);
    update_npc_story_state(param_1);
    return;
}

void do_unlock_scenes(int param_1){
    int global_manager = get_module("GlobalManager");
    if(has_wand_check() == 1){
        fade_out(0,0,0,0x3c);
    }

    // Sneasel
    if(@syscall(0,0x15,0x29,global_manager,0x48) == 1){
        show_unlock_cutscene_at_position(param_1,0x9e,"32_00130",10,0,-259.4,56.0,977.0);
    }
    // Glalie
    if(@syscall(0,0x15,0x29,global_manager,0x49) == 1){
        show_unlock_cutscene_at_position(param_1,0xb2,"32_00140",20,0,-189.0,45.0,886.0);
    }
    // Delibird
    if(@syscall(0,0x15,0x29,global_manager,0x4a) == 1){
        show_unlock_cutscene_at_position(param_1,0xa5,"32_00150",10,0,-1058.0,113.0,520.0);
    }
    // Smoochum
    if(@syscall(0,0x15,0x29,global_manager,0x4b) == 1){
        show_unlock_cutscene_at_position(param_1,0xa8,"32_00160",0,0,-1058.0,113.0,520.0);
    }
    // Squirtle
    if(@syscall(0,0x15,0x29,global_manager,0x4c) == 1){
        show_unlock_cutscene_at_position(param_1,0xa9,"32_00170",0,0,-1058.0,113.0,520.0);
    }
    // Mamoswine
    if(@syscall(0,0x15,0x29,global_manager,0x4d) == 1){
        show_unlock_cutscene_at_position(param_1,0xb6,"32_00250",20,0,-678.0,45.0,858.0);
    }
    // Primeape
    if(@syscall(0,0x15,0x29,global_manager,0x4e) == 1){
        show_unlock_cutscene_at_position(param_1,0xaf,"32_00200",10,0,-259.4,56.0,977.0);
    }
    // Ursaring
    if(@syscall(0,0x15,0x29,global_manager,0x4f) == 1){
        show_unlock_cutscene_at_position(param_1,0xb0,"32_00210",20,0,-109.0,47.0,856.0);
    }

    int event_script = get_module("EventScript");
    @syscall(0,0x15,400,event_script,0,1);
    int audio_state = @syscall(0,0x15,0x1f7,event_script,0x17e4);
    if(audio_state == 0){
        fade_in_bgm(0x1e);
    }
    return;
}

void special_spawn_condition(int param_1){
    int global_manager = get_module("GlobalManager");

    spawn_object_if_missing(0xb5);
    set_object_position(0xb5,-1189,-8,-335);
    set_object_rotation_instantly(0xb5,0,12,0);
    reset_object_after_event(0xb5);

    spawn_object_if_missing(0xcf);
    set_object_position(0xcf,-68,-1,221);
    set_object_rotation_instantly(0xcf,0,165,0);
    reset_object_after_event(0xcf);

    set_object_position(0xa6,-1080,114,450);
    set_object_rotation_instantly(0xa6,0,8,0);
    reset_object_after_event(0xa6);
    return;
}

