void delibird_dialog(int param_1){
    int global_manager = get_module("GlobalManager");
    int completed_present_count = @syscall(0,0x15,1,global_manager,"f0302DelibirdPresent");
    @syscall(0,6,completed_present_count,"delibird_stage");

    if(completed_present_count == 4 || REMOVE_ERRAND_POWER_COMP_LOCATIONS){
        @syscall(0,6,1,"delibird_branch_complete");
        quiz_dialog(
            param_1,
            0xa5,
            0x14cc,
            2,
            "32_00340",
            "32_90340",
            "32_90350",
            "32_90370",
            "32_90390",
            "32_90380"
        );
        return;
    }

    delibird_present_dialog(param_1);
}

void delibird_present_dialog(int param_1){
    const int object_id = 0xa5;
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    lock_player_and_get_accessor();
    int object_accessor = lock_npc_and_get_accessor(object_id);
    face_player_and_npc(object_id,0);

    int held_item_kind = get_held_item_kind();
    int tamazarashi_present_state = @syscall(0,0x15,1,global_manager,"zfPresentTamazarashi");
    int himeguma_present_state = @syscall(0,0x15,1,global_manager,"zfPresentHimeguma");
    int zenigame_present_state = @syscall(0,0x15,1,global_manager,"zfPresentZenigame");
    int muchul_present_state = @syscall(0,0x15,1,global_manager,"zfPresentMuchul");

    @syscall(0,6,held_item_kind,"delibird_held_item");
    @syscall(0,6,tamazarashi_present_state,"delibird_z_tamazarashi");
    @syscall(0,6,himeguma_present_state,"delibird_z_himeguma");
    @syscall(0,6,zenigame_present_state,"delibird_z_zenigame");
    @syscall(0,6,muchul_present_state,"delibird_z_muchul");

    // recover
    if(
        @syscall(0,0x15,1,global_manager,"f0302PresentTamazarashi") == 1 &&
        tamazarashi_present_state == 0
    ){
        @syscall(0,6,0,"delibird_recover_slot");
        @syscall(0,0x15,0,global_manager,"f0302PresentTamazarashi",2);
    }
    if(
        @syscall(0,0x15,1,global_manager,"f0302PresentHimeguma") == 1 &&
        himeguma_present_state == 0
    ){
        @syscall(0,6,1,"delibird_recover_slot");
        @syscall(0,0x15,0,global_manager,"f0302PresentHimeguma",2);
    }
    if(
        @syscall(0,0x15,1,global_manager,"f0302PresentZenigame") == 1 &&
        zenigame_present_state == 0
    ){
        @syscall(0,6,2,"delibird_recover_slot");
        @syscall(0,0x15,0,global_manager,"f0302PresentZenigame",2);
    }
    if(
        @syscall(0,0x15,1,global_manager,"f0302PresentMuchul") == 1 &&
        muchul_present_state == 0
    ){
        @syscall(0,6,3,"delibird_recover_slot");
        @syscall(0,0x15,0,global_manager,"f0302PresentMuchul",2);
    }

    int completed_present_count = @syscall(0,0x15,1,global_manager,"f0302DelibirdPresent");

    if(
        held_item_kind == 8 ||
        tamazarashi_present_state + himeguma_present_state + zenigame_present_state + muchul_present_state != 0
    ){
        @syscall(0,6,1,"delibird_branch_blocked");
        @syscall(0,0x15,0x28,object_accessor,0x14cc,0,1.0,1.0);
        show_npc_dialog(param_1,"32_90240");
        end_event_script(param_1);
        return;
    }

    if(
        @syscall(0,0x15,1,global_manager,"f0302PresentTamazarashi") == 2 ||
        @syscall(0,0x15,1,global_manager,"f0302PresentHimeguma") == 2 ||
        @syscall(0,0x15,1,global_manager,"f0302PresentZenigame") == 2 ||
        @syscall(0,0x15,1,global_manager,"f0302PresentMuchul") == 2
    ){
        @syscall(0,0x15,0x28,object_accessor,0x14cc,0,1.0,1.0);
        show_npc_dialog(param_1,"32_90291");
        drop_held_item_animation();
        if(@syscall(0,0x15,1,global_manager,"f0302PresentTamazarashi") == 2){
            @syscall(0,6,0,"delibird_reissue_slot");
            give_present(0x2afd,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentTamazarashi",1);
            @syscall(0,0x15,0,global_manager,"zfPresentTamazarashi",1);
        }
        else if(@syscall(0,0x15,1,global_manager,"f0302PresentHimeguma") == 2){
            @syscall(0,6,1,"delibird_reissue_slot");
            give_present(0x2afe,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentHimeguma",1);
            @syscall(0,0x15,0,global_manager,"zfPresentHimeguma",1);
        }
        else if(@syscall(0,0x15,1,global_manager,"f0302PresentZenigame") == 2){
            @syscall(0,6,2,"delibird_reissue_slot");
            give_present(0x2aff,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentZenigame",1);
            @syscall(0,0x15,0,global_manager,"zfPresentZenigame",1);
        }
        else if(@syscall(0,0x15,1,global_manager,"f0302PresentMuchul") == 2){
            @syscall(0,6,3,"delibird_reissue_slot");
            give_present(0x2b00,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentMuchul",1);
            @syscall(0,0x15,0,global_manager,"zfPresentMuchul",1);
        }
        end_event_script(param_1);
        return;
    }

    bool spheal_is_friend = is_friend(0xa3);
    bool teddiursa_is_friend = is_friend(0xbe);
    bool squirtle_is_friend = is_friend(0xa9);
    bool smoochum_is_friend = is_friend(0xa8);
    // to match the APWorld logic, could be reduced to only friendship check now
    bool squirtle_unlocked = @syscall(0,0x15,0x29,global_manager,0x4C) == 1;
    bool smoochum_unlocked = @syscall(0,0x15,0x29,global_manager,0x4B) == 1;
    @syscall(0,6,spheal_is_friend,"delibird_friend_spheal");
    @syscall(0,6,teddiursa_is_friend,"delibird_friend_teddiursa");
    @syscall(0,6,squirtle_is_friend,"delibird_friend_squirtle");
    @syscall(0,6,smoochum_is_friend,"delibird_friend_smoochum");
    @syscall(0,6,squirtle_unlocked,"delibird_unlocked_squirtle");
    @syscall(0,6,smoochum_unlocked,"delibird_unlocked_smoochum");

    bool can_start_present =
        (completed_present_count == 0 && spheal_is_friend) ||
        (completed_present_count == 1 && teddiursa_is_friend) ||
        (completed_present_count == 2 && squirtle_is_friend && squirtle_unlocked) ||
        (completed_present_count == 3 && smoochum_is_friend && smoochum_unlocked);
    if(can_start_present){
        @syscall(0,6,completed_present_count,"delibird_issue_slot");
        @syscall(0,0x15,0x28,object_accessor,0x14cc,0,1.0,1.0);
        if(completed_present_count == 0){
            show_npc_dialog(param_1,"32_90250");
            drop_held_item_animation();
            give_present(0x2afd,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentTamazarashi",1);
            @syscall(0,0x15,0,global_manager,"zfPresentTamazarashi",1);
        }
        else if(completed_present_count == 1){
            show_npc_dialog(param_1,"32_90260");
            drop_held_item_animation();
            give_present(0x2afe,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentHimeguma",1);
            @syscall(0,0x15,0,global_manager,"zfPresentHimeguma",1);
        }
        else if(completed_present_count == 2){
            show_npc_dialog(param_1,"32_90270");
            drop_held_item_animation();
            give_present(0x2aff,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentZenigame",1);
            @syscall(0,0x15,0,global_manager,"zfPresentZenigame",1);
        }
        else if(completed_present_count == 3){
            show_npc_dialog(param_1,"32_90280");
            drop_held_item_animation();
            give_present(0x2b00,1);
            @syscall(0,0x15,0,global_manager,"f0302PresentMuchul",1);
            @syscall(0,0x15,0,global_manager,"zfPresentMuchul",1);
        }
        if(
            @syscall(0,0x15,1,global_manager,"f0302DelibirdTalk") == 0 &&
            completed_present_count == 3
        ){
            show_npc_dialog(param_1,"32_90290");
            @syscall(0,0x15,0,global_manager,"f0302DelibirdTalk",1);
        }
        end_event_script(param_1);
        return;
    }

    @syscall(0,6,completed_present_count,"delibird_wait_slot");
    @syscall(0,0x15,0x28,object_accessor,0x14cc,0,1.0,1.0);
    if(completed_present_count == 0){
        show_npc_dialog(param_1,"32_90200");
    }
    else if(completed_present_count == 1){
        show_npc_dialog(param_1,"32_90210");
    }
    else if(completed_present_count == 2){
        show_npc_dialog(param_1,"32_90220");
    }
    else if(completed_present_count == 3){
        show_npc_dialog(param_1,"32_90230");
    }
    else{
        show_npc_dialog(param_1,"32_90240");
    }
    end_event_script(param_1);
}

