string get_quiz_dialog_id(int quiz_id, int kind, int index) {
  if (quiz_id == 0) {
    if (kind == QUIZ_DIALOG_INTRO) {
      if (index == 0) {
        return "32_10160";
      }
      return "32_10191";
    }
    if (kind == QUIZ_DIALOG_ROUND_INTRO) {
      if (index == 0) {
        return "32_10192";
      }
      return "32_10193";
    }
    if (kind == QUIZ_DIALOG_CORRECT) {
      return "32_10195";
    }
    return "32_10196";
  }
  if (quiz_id == 1) {
    if (kind == QUIZ_DIALOG_INTRO) {
      if (index == 0) { return "32_10660"; }
      return "32_10691";
    }
    if (kind == QUIZ_DIALOG_ROUND_INTRO) {
      if (index == 0) { return "32_10692"; }
      return "32_10693";
    }
    if (kind == QUIZ_DIALOG_CORRECT) { return "32_10695"; }
    return "32_10696";
  }
  if (quiz_id == 2) {
    if (kind == QUIZ_DIALOG_INTRO) {
      if (index == 0) { return "32_90360"; }
      return "32_90400";
    }
    if (kind == QUIZ_DIALOG_ROUND_INTRO) {
      if (index == 0) { return "32_90410"; }
      return "32_90420";
    }
    if (kind == QUIZ_DIALOG_CORRECT) { return "32_90440"; }
    return "32_90450";
  }
  return "";
}
