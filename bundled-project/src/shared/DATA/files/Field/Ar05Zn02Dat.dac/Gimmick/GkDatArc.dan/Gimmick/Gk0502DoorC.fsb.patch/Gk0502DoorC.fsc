extern int get_module(string name);

export void WAIT(int param_1){
    int global_manager = get_module("GlobalManager");
    int doors_unlocked = @syscall(0,0x15,1,global_manager,"f0502DoorA");
    if(doors_unlocked == 1){
        int door = @syscall(0,0x15,4,param_1);
        @syscall(0,0x15,0,door,param_1,2);
    }
    else{
        int door = @syscall(0,0x15,5,param_1);
        @syscall(0,0x15,0,door,param_1,0);
    }
}
