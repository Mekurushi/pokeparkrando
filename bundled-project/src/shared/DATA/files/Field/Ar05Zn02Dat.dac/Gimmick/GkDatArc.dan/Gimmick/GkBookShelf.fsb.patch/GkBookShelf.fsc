extern int get_module(string name);

export void WAIT0(int param_1){
    int global_manager = get_module("GlobalManager");
    int has_dusknoir_prisma = @syscall(0,0x15,0x51,global_manager,0x4);
    if(has_dusknoir_prisma == 1){
        int bookshelf = @syscall(0,0x15,4,param_1);
        @syscall(0,0x15,0,bookshelf,param_1,3);
    }
    else{
        int bookshelf = @syscall(0,0x15,5,param_1);
        @syscall(0,0x15,0,bookshelf,param_1,0);
    }
}
