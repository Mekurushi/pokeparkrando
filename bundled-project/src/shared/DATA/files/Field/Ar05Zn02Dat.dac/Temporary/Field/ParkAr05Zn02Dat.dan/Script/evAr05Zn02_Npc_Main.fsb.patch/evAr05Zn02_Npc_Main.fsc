string get_quiz_dialog_id(int quiz_id, int kind, int index){
    if(kind == QUIZ_DIALOG_INTRO){
        if(index == 0){ return "52_12160"; }
        return "52_12200";
    }
    if(kind == QUIZ_DIALOG_ROUND_INTRO){
        if(index == 0){ return "52_12210"; }
        return "52_12220";
    }
    if(kind == QUIZ_DIALOG_CORRECT){ return "52_12240"; }
    return "52_12250";
}
