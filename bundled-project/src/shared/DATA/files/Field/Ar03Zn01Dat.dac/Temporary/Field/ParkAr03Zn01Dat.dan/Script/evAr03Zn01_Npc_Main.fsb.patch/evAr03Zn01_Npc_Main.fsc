void bidoof_dialog(int param_1){
    const int BIDOOF_OBJECT_ID = 0x84;
    int event_script = get_module("EventScript");
    int global_manager = get_module("GlobalManager");
    lock_player_and_get_accessor();

    int wood_level = @syscall(0,0x15,1,global_manager,"fBippasWoodLevel");
    int held_item_kind = get_held_item_kind();

    int bidoof_accessor = lock_npc_and_get_accessor(BIDOOF_OBJECT_ID);
    face_player_and_npc(BIDOOF_OBJECT_ID,0);

    int has_pelipper_prisma = @syscall(0,0x15,0x51,global_manager,0x6);
    if(wood_level == 1 && has_pelipper_prisma == 0){
        @syscall(0,0x15,0x28,bidoof_accessor,0xa40,0,1.0,1.0);
        show_npc_dialog(param_1,"31_60002");
        end_event_script(param_1);
        return;
    }

    if(wood_level == 3){
        @syscall(0,0x15,0x28,bidoof_accessor,0xa40,0,1.0,1.0);
        @syscall(0,0x15,2,bidoof_accessor,0x13,10);
        show_npc_dialog(param_1,"31_12500");
        end_event_script(param_1);
        return;
    }

    if(held_item_kind == -1){
        @syscall(0,0x15,0x28,bidoof_accessor,0xa40,0,1.0,1.0);
        wood_level = @syscall(0,0x15,1,global_manager,"fBippasWoodLevel");
        if(wood_level == 0){
            show_npc_dialog(param_1,"31_60001");
        }
        else if(wood_level == 1){
            show_npc_dialog(param_1,"31_60090");
        }
        else if(wood_level == 2){
            show_npc_dialog(param_1,"31_60111");
        }
        end_event_script(param_1);
        return;
    }
    else if(held_item_kind == 1){
        @syscall(0,0x15,0x28,bidoof_accessor,0xa40,0,1.0,1.0);
        @syscall(0,0x15,2,bidoof_accessor,0xb,10);
        wood_level = @syscall(0,0x15,1,global_manager,"fBippasWoodLevel");
        if(wood_level == 0){
            show_npc_dialog(param_1,"31_60003");
            fade_out(0,0,0,0x2d);
            remove_held_item();
            @syscall(0,0x15,0,global_manager,"fBippasWoodLevel",1);
            start_carvanha_scene(param_1);
            end_event_script(param_1);
        }
        else if(wood_level == 1){
            show_npc_dialog(param_1,"31_60100");
            @syscall(0,0x15,0,global_manager,"fBippasWoodLevel",2);
            fade_out(0,0,0,0x2d);
            remove_held_item();
        }
        else if(wood_level == 2){
            show_npc_dialog(param_1,"31_60110");
            @syscall(0,0x15,0,global_manager,"fBippasWoodLevel",3);
            fade_out(0,0,0,0x2d);
            remove_held_item();
        }
    }
    else{
        @syscall(0,0x15,0x28,bidoof_accessor,0xa40,0,1.0,1.0);
        show_npc_dialog(param_1,"31_60121");
    }

    fade_out(0,0,0,0x2d);
    respawn_field();
    special_spawn_condition(param_1);
    update_npc_story_state(param_1);
    @syscall(0,0x15,0xca,event_script,-1);
    wait_frames(1);
    fade_in(0,0,0,0x2d);
    end_event_script(param_1);
}

void lapras_dialog(int param_1){
    const int LAPRAS_OBJECT_ID = 0x86;
    int player_accessor = lock_player_and_get_accessor();

    int lapras_accessor = lock_npc_and_get_accessor(LAPRAS_OBJECT_ID);
    face_player_and_npc(LAPRAS_OBJECT_ID,0);

    @syscall(0,0x15,0x28,lapras_accessor,0x1274,0,1.0,1.0);
    @syscall(0,0x15,2,lapras_accessor,0x1b,10);
    show_npc_dialog(param_1,"31_60261");

    int wants_to_travel = attraction_show_yes_no_question(param_1,"31_60270");
    if(wants_to_travel == 1){
        @syscall(0,0x15,2,lapras_accessor,0x1b,10);
        drop_held_item_animation();
        if(!is_location_checked(LAPRAS_OBJECT_ID)){
            show_npc_dialog(param_1,"31_60262");
            @syscall(0,0x15,2,player_accessor,0x39,5);
            friendship_banner("31_00616");
            check_location(LAPRAS_OBJECT_ID);
            show_npc_dialog(param_1,"31_60290");
        }
        else{
            show_npc_dialog(param_1,"31_60290");
        }
        fade_out(0,0,0,0x3c);
        int event_script = get_module("EventScript");
        @syscall(0,0x15,4,event_script,0,1);
        end_event_script(param_1);
    }
    else{
        @syscall(0,0x15,2,lapras_accessor,0x1b,10);
        show_npc_dialog(param_1,"31_60280");
    }

    update_npc_story_state(param_1);
    end_event_script(param_1);
}

void pelipper_dialog(int param_1){
    const int PELIPPER_OBJECT_ID = 0x87;
    const int ATTRACTION_FEE = 10;

    int player_accessor = lock_player_and_get_accessor();
    int pelipper_accessor = lock_npc_and_get_accessor(PELIPPER_OBJECT_ID);
    face_player_and_npc(PELIPPER_OBJECT_ID,0);

    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"31_60210");
    if(wants_to_enter == 1){
        int global_manager = get_module("GlobalManager");
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < ATTRACTION_FEE){
            @syscall(0,0x15,2,pelipper_accessor,0x1b,10);
            @syscall(0,0x15,0x28,pelipper_accessor,0xe78,0,1.0,1.0);
            show_npc_dialog(param_1,"31_60240");
        }
        else{
            @syscall(0,0x15,2,pelipper_accessor,0x1c,10);
            @syscall(0,0x15,0x28,pelipper_accessor,0xe78,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
            show_npc_dialog(param_1,"31_60230");
            set_berry_counter_visible(false);
            @syscall(0,0x15,0,global_manager,"fRetAttraction",7);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,BEACH_ZONE_MAIN_AREA_PELIPPER_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,pelipper_accessor,0x1b,10);
        @syscall(0,0x15,0x28,pelipper_accessor,0xe78,0,1.0,1.0);
        show_npc_dialog(param_1,"31_60220");
    }

    set_berry_counter_visible(false);
    rotate_object(PELIPPER_OBJECT_ID,0,0xb4,0);
    update_npc_story_state(param_1);
    end_event_script(param_1);
}

void gyarados_dialog(int param_1){
    const int GYARADOS_OBJECT_ID = 0x88;
    const int ATTRACTION_FEE = 10;

    int player_accessor = lock_player_and_get_accessor();
    int gyarados_accessor = lock_npc_and_get_accessor(GYARADOS_OBJECT_ID);
    face_player_and_npc(GYARADOS_OBJECT_ID,0);

    @syscall(0,0x15,2,gyarados_accessor,0x1b,10);
    @syscall(0,0x15,0x28,gyarados_accessor,0xc4d,0,1.0,1.0);
    set_berry_counter_visible(true);
    int wants_to_enter = attraction_show_yes_no_question(param_1,"31_60150");
    if(wants_to_enter == 1){
        int global_manager = get_module("GlobalManager");
        int berry_count = @syscall(0,0x15,0x15,global_manager);
        if(berry_count < ATTRACTION_FEE){
            @syscall(0,0x15,2,gyarados_accessor,0x1b,10);
            @syscall(0,0x15,0x28,gyarados_accessor,0xc4d,0,1.0,1.0);
            show_npc_dialog(param_1,"31_60180");
        }
        else{
            @syscall(0,0x15,2,gyarados_accessor,0x1c,10);
            @syscall(0,0x15,0x28,gyarados_accessor,0xc4d,0,1.0,1.0);
            @syscall(0,0x15,0x14,global_manager,-ATTRACTION_FEE);
            show_npc_dialog(param_1,"31_60170");
            set_berry_counter_visible(false);
            @syscall(0,0x15,0,global_manager,"fRetAttraction",6);
            fade_out(0,0,0,0x1e);
            @syscall(0,0x15,0,player_accessor,0);
            enter_attraction(param_1,BEACH_ZONE_RECYCLE_AREA_GYARADOS_ATTRACTION_ID);
        }
    }
    else{
        @syscall(0,0x15,2,gyarados_accessor,0x1b,10);
        @syscall(0,0x15,0x28,gyarados_accessor,0xc4d,0,1.0,1.0);
        show_npc_dialog(param_1,"31_60160");
    }

    set_berry_counter_visible(false);
    rotate_object(GYARADOS_OBJECT_ID,0,0xa9,0);
    end_event_script(param_1);
}

