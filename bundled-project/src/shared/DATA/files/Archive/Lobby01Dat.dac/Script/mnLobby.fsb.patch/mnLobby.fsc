extern int get_module(string name);
extern void finalize_lobby_pokemon_list();

extern static int[256] data_50080;
extern static int[256] data_50388;
extern static int[256] data_50690;
extern static int[0x1a] pokemon_ids;
extern static int[0x1a] selection_enabled_array;
extern static int[0x1a] data_50a80;
extern static int[0x1a] data_50ae8;
extern static int[0x1a] data_50b50;
extern static int[0x1a] data_50bb8;
extern static int[0x1a] data_50c20;
extern static int selection_index;
extern static int data_50c8c;
extern static int data_50cb0;
extern static int data_50cb4;
extern static int data_50cb8;
extern static int data_50cbc;
extern static int data_50cc0;
extern static int data_50cc4;
extern static int data_50cc8;
extern static int data_50ccc;
extern static int data_50cd0;
extern static int data_50cd4;

void initialize_lobby_state(int param_1, int param_2){
    int lobby = get_module("mnLobby");
    int global_manager = get_module("GlobalManager");

    data_50cd4 = 0;
    data_50cb0 = 0;
    data_50cb4 = 0;
    data_50c8c = 1;

    int pokemon_id = @syscall(0,0x15,0x17,lobby);
    if(pokemon_id != -1){
        int pokemon_state = @syscall(0,0x15,0xb6,global_manager,pokemon_id);
        if(pokemon_state == 0){
            data_50c8c = 0;
        }
    }

    data_50cbc = -1;
    data_50cc0 = @syscall(0,0x15,5,lobby);
    if(param_2 == 0){
        data_50cb8 = 0;
    }
    else{
        data_50cb8 = data_50cc0 - 1;
    }

    int state = @syscall(0,0x15,0x24,global_manager);
    if(state == 0){
        data_50cc4 = @syscall(0,0x15,0x68,global_manager,param_1);
    }
    else{
        data_50cc4 = 1;
    }

    data_50cc8 = @syscall(0,0x15,0x67,global_manager,param_1);
    data_50ccc = @syscall(0,0x15,0x50,global_manager,param_1);
    data_50cd0 = @syscall(0,0x15,0x65,global_manager,param_1);
    return;
}

void build_lobby_pokemon_list(int param_1){
    int global_manager = get_module("GlobalManager");
    int pokemon_count = @syscall(0,0x15,0x54,global_manager,param_1);
    if(pokemon_count > 0x1a){
        pokemon_count = 0x1a;
    }

    selection_index = 0;
    for(int pokemon_index = 0; pokemon_index < pokemon_count; pokemon_index = pokemon_index + 1){
        int pokemon_id = @syscall(
            0,0x15,0x58,global_manager,param_1,pokemon_index
        );
        if(pokemon_id == -1){
            continue;
        }

        pokemon_ids[selection_index] = pokemon_id;
        selection_enabled_array[selection_index] = @syscall(
            0,0x15,0x3d,global_manager,pokemon_id
        );

        int pokemon_state;
        if(pokemon_id == 0){
            pokemon_state = 1;
        }
        else{
            pokemon_state = @syscall(
                0,0x15,0x44,global_manager,pokemon_id,param_1
            );
        }

        if(selection_enabled_array[selection_index] != 0 && pokemon_state == 0){
            data_50a80[selection_index] = 1;
            @syscall(0,0x15,0x43,global_manager,pokemon_id,param_1);
        }
        else{
            data_50a80[selection_index] = 0;
        }

        if(pokemon_id == 0){
            pokemon_state = 1;
        }
        else{
            pokemon_state = @syscall(
                0,0x15,0x40,global_manager,pokemon_id,param_1
            );
        }

        if(pokemon_state == 0){
            data_50ae8[selection_index] = 1;
        }
        else{
            data_50ae8[selection_index] = 0;
        }

        int pokemon_index = @syscall(
            0,0x15,0x45,global_manager,pokemon_id
        );
        data_50b50[selection_index] = data_50080[pokemon_index];
        data_50bb8[selection_index] = data_50690[pokemon_index];
        data_50c20[selection_index] = data_50388[pokemon_index];
        selection_index = selection_index+1;
    }

    finalize_lobby_pokemon_list();
    return;
}
